<UserControl x:Class="DiagnosticLabs.Wpf.Controls.CrudLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Loaded="OnLoaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>

  <UserControl.InputBindings>
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding ToggleSearchCommand}" />
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewRecordCommand}" />
  </UserControl.InputBindings>

  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title and the Search toggle -->
    <DockPanel Grid.Row="0" Margin="0,0,0,14">
      <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsSearchVisible, Mode=TwoWay}"
                    Padding="14,6" MinWidth="96" Cursor="Hand" VerticalAlignment="Center"
                    ToolTip="Show or hide the list of records (Ctrl+F)">
        <ToggleButton.Style>
          <Style TargetType="ToggleButton">
            <Setter Property="Content" Value="Search &#x25B8;" />
            <Style.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="Hide list &#x25C2;" />
                <Setter Property="Background" Value="#E6ECF9" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </ToggleButton.Style>
      </ToggleButton>
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- The record being edited -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
              BorderThickness="1" CornerRadius="4" Padding="22,8,22,16" MinWidth="320">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <!-- The form grows to FormMaxWidth and stays at the left; the tiny second column takes whatever is left over. -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FormColumn" Width="*" MaxWidth="680" />
                <ColumnDefinition Width="0.0001*" />
              </Grid.ColumnDefinitions>
              <ContentControl x:Name="FormHost" Content="{Binding FormContent, ElementName=Root}" />
            </Grid>
          </ScrollViewer>

          <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,0,0,10"
                      Visibility="{Binding HasActiveFlag, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource StatusText}" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal">
              <Button Content="New" Command="{Binding NewRecordCommand}" IsEnabled="{Binding CanCreate}" />
              <Button Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                      Click="Save_OnClick" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
              <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                      Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" />
              <ContentControl Content="{Binding FooterContent, ElementName=Root}" Margin="8,0,0,0" IsTabStop="False" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Search + list, shown on the right only when toggled on -->
      <Grid Grid.Column="1" Width="520" Margin="20,0,0,0"
            Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVis}}"
            IsVisibleChanged="SearchPanel_OnIsVisibleChanged">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Search" KeyDown="SearchBox_OnKeyDown" />
          <Button Grid.Column="1" Content="Search" Margin="8,0,0,0" Command="{Binding SearchCommand}" />
        </Grid>

        <StackPanel Grid.Row="1">
          <ContentControl Content="{Binding SearchFilters, ElementName=Root}" IsTabStop="False" />
          <CheckBox Content="Show inactive" Margin="0,0,0,8" IsChecked="{Binding IncludeInactive}"
                    Visibility="{Binding HasActiveFlag, Converter={StaticResource BoolToVis}}"
                    Checked="IncludeInactive_OnChanged" Unchecked="IncludeInactive_OnChanged" />
        </StackPanel>

        <ContentControl Grid.Row="2" Content="{Binding GridContent, ElementName=Root}" />

        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
          <Button DockPanel.Dock="Left" Content="Previous" Command="{Binding PreviousPageCommand}"
                  IsEnabled="{Binding CanGoPrevious}" />
          <Button DockPanel.Dock="Left" Content="Next" Margin="8,0,0,0" Command="{Binding NextPageCommand}"
                  IsEnabled="{Binding CanGoNext}" />
          <TextBlock DockPanel.Dock="Left" Text="{Binding PageDisplay}" VerticalAlignment="Center" Margin="14,0,0,0"
                     Foreground="{StaticResource MutedTextBrush}" />
          <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}"
                    Width="70" SelectionChanged="PageSize_OnSelectionChanged" ToolTip="Rows per page" />
        </DockPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
