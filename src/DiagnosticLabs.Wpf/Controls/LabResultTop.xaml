<UserControl x:Class="DiagnosticLabs.Wpf.Controls.LabResultTop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:DiagnosticLabs.Wpf.Controls">
  <!-- The top of every lab result form, in the order of the paper form: the registration box and photo box, the patient block, the yellow title bar. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Registration (optional) -->
      <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Background="White" Padding="12,0,12,6" Margin="0,2,12,0">
        <StackPanel>
          <DockPanel Margin="0,4,0,2">
            <TextBlock DockPanel.Dock="Right" Text="{Binding RegistrationCaption}" Foreground="{StaticResource MutedTextBrush}" Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding RegistrationCaption}" MaxWidth="560" />
            <TextBlock Text="Registration (optional)" Foreground="{StaticResource MutedTextBrush}" />
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <TextBox Tag="Autofocus" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Type a registration code and press Enter, or start typing a patient name. Leave empty for a result without a registration.">
                <TextBox.InputBindings>
                  <KeyBinding Key="Return" Command="{Binding FindCommand}" />
                </TextBox.InputBindings>
              </TextBox>
              <Popup PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}" Placement="Bottom" StaysOpen="True"
                     Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
                <Popup.Style>
                  <Style TargetType="Popup">
                    <Setter Property="IsOpen" Value="False" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding HasSuggestions}" Value="True" />
                          <Condition Binding="{Binding PlacementTarget.IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="IsOpen" Value="True" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Popup.Style>
                <Border Background="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                  <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Suggestions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource SuggestionButton}" CommandParameter="{Binding}"
                                  Command="{Binding DataContext.PickSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <StackPanel>
                              <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" />
                              <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11">
                                <Run Text="{Binding RegistrationCode, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Date, Mode=OneWay, StringFormat='dd MMM yy'}" />
                              </TextBlock>
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <Button Grid.Column="1" Content="Find" Margin="8,0,0,0" MinWidth="64" Command="{Binding FindCommand}" />
            <Button Grid.Column="2" Content="No registration" Margin="8,0,0,0" MinWidth="0" Padding="8,6" Command="{Binding ChangeRegistrationCommand}"
                    Visibility="{Binding HasRegistration, Converter={StaticResource BoolToVis}}"
                    ToolTip="Stop using this registration and type the patient in (a result for someone who is not registered)" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Photo box (kept from the old form) -->
      <Border Grid.Column="1" Width="68" Height="68" Margin="0,2,0,0" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="1" Background="White" VerticalAlignment="Top">
        <Image Source="{Binding Photo}" Stretch="Uniform" />
      </Border>
    </Grid>

    <!-- A thin line separates the registration box from the form -->
    <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Margin="0,10,0,10" />

    <!-- Patient block, laid out like the paper: code / age / sex, name / date requested, company or physician -->
    <Grid Margin="0,0,0,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" MinWidth="125" />
        <ColumnDefinition Width="*" MinWidth="60" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="Auto" MinWidth="100" />
        <ColumnDefinition Width="0.8*" MaxWidth="150" />
        <ColumnDefinition Width="Auto" MinWidth="40" />
        <ColumnDefinition Width="0.8*" MaxWidth="125" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="Patient Code:" Style="{StaticResource PaperLabel}" />
      <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" Text="{Binding PatientCode, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsPatientLocked}">
        <TextBox.Style>
          <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
              <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="#EEF0F3" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </TextBox.Style>
      </TextBox>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="Age:" Style="{StaticResource PaperLabel}" />
      <TextBox Grid.Row="0" Grid.Column="4" Margin="0,2" Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Grid.Row="0" Grid.Column="5" Text="Sex:" Style="{StaticResource PaperLabel}" HorizontalAlignment="Right" />
      <ctl:ChoiceBox Grid.Row="0" Grid.Column="6" Margin="0,2" ItemsSource="{Binding Genders}" Text="{Binding Sex}" EditCommand="{Binding EditGenderListCommand}" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Patient Name:" Style="{StaticResource PaperLabel}" />
      <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Grid.Row="1" Grid.Column="3" Text="Date Requested:" Style="{StaticResource PaperLabel}" />
      <DatePicker Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="3" Margin="0,2" SelectedDate="{Binding DateRequested}" />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="Company/Physician:" Style="{StaticResource PaperLabel}" />
      <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" IsEditable="True" ItemsSource="{Binding CompanyNames}"
                Text="{Binding CompanyOrPhysician, UpdateSourceTrigger=LostFocus}" ToolTip="Pick a company or type a physician's name" />
    </Grid>

  </StackPanel>
</UserControl>