<UserControl x:Class="DiagnosticLabs.Wpf.Controls.LabResultTop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icn="clr-namespace:DiagnosticLabs.Wpf.Controls"
             xmlns:ctl="clr-namespace:DiagnosticLabs.Wpf.Controls">
  <!-- The top of every lab result form, in the order of the paper form: the registration box and photo box, the patient block, the yellow title bar. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <StackPanel>
    <!-- While an administrator sets the defaults, this banner replaces the registration box -->
    <Border Background="{StaticResource HoverTintBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="12,8" Margin="0,2,0,0"
            Visibility="{Binding IsSettingDefaults, Converter={StaticResource BoolToVis}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button icn:ButtonIcon.Data="{StaticResource Icon.Save}" Content="Save defaults" Style="{StaticResource PrimaryButton}" Command="{Binding SaveDefaultsCommand}" />
          <Button icn:ButtonIcon.Data="{StaticResource Icon.Cancel}" Content="Clear defaults" Margin="8,0,0,0" Command="{Binding ClearDefaultsCommand}" ToolTip="Remove the saved defaults; new results will start empty" />
          <Button icn:ButtonIcon.Data="{StaticResource Icon.Cancel}" Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelDefaultsCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding DefaultsBanner}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Grid Visibility="{Binding IsNotSettingDefaults, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Registration (optional) -->
      <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Background="White" Padding="12,0,12,6" Margin="0,2,12,0">
        <StackPanel>
          <DockPanel Margin="0,4,0,2">
            <TextBlock DockPanel.Dock="Right" Text="{Binding RegistrationCaption}" Foreground="{StaticResource MutedTextBrush}" Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding RegistrationCaption}" MaxWidth="560" />
            <TextBlock Text="Registration (optional)" Foreground="{StaticResource MutedTextBrush}" />
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <TextBox Padding="6,5,28,5" Tag="Autofocus" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Type a registration code and press Enter, or start typing a patient name. Leave empty for a result without a registration.">
                <TextBox.InputBindings>
                  <KeyBinding Key="Return" Command="{Binding FindCommand}" />
                </TextBox.InputBindings>
              </TextBox>
              <Path Style="{StaticResource SearchGlyph}" />
              <Popup PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}" Placement="Bottom" StaysOpen="True"
                     Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
                <Popup.Style>
                  <Style TargetType="Popup">
                    <Setter Property="IsOpen" Value="False" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding HasSuggestions}" Value="True" />
                          <Condition Binding="{Binding PlacementTarget.IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="IsOpen" Value="True" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Popup.Style>
                <Border Background="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                  <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Suggestions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource SuggestionButton}" CommandParameter="{Binding}"
                                  Command="{Binding DataContext.PickSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <StackPanel>
                              <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" />
                              <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11">
                                <Run Text="{Binding RegistrationCode, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Date, Mode=OneWay, StringFormat='dd MMM yy'}" />
                              </TextBlock>
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <Button Grid.Column="1" icn:ButtonIcon.Data="{StaticResource Icon.Search}" Content="Find" Margin="8,0,0,0" MinWidth="64" Command="{Binding FindCommand}" />
            <Button Grid.Column="2" Content="No registration" Margin="8,0,0,0" MinWidth="0" Padding="8,6" Command="{Binding ChangeRegistrationCommand}"
                    Visibility="{Binding HasRegistration, Converter={StaticResource BoolToVis}}"
                    ToolTip="Stop using this registration and type the patient in (a result for someone who is not registered)" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Photo box (kept from the old form) -->
      <Border Grid.Column="1" Width="68" Height="68" Margin="0,2,0,0" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="1" Background="White" VerticalAlignment="Top">
        <Image Source="{Binding Photo}" Stretch="Uniform" />
      </Border>
    </Grid>

    <!-- A thin line separates the registration box from the form -->
    <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Margin="0,10,0,10" />

    <!-- Patient block, laid out like the paper: code / age / sex, name / date requested, company or physician -->
    <Grid Margin="0,0,0,12" IsEnabled="{Binding IsNotSettingDefaults}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" MinWidth="170" />
        <ColumnDefinition Width="*" MinWidth="60" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="Auto" MinWidth="100" />
        <ColumnDefinition Width="0.8*" MaxWidth="150" />
        <ColumnDefinition Width="Auto" MinWidth="40" />
        <ColumnDefinition Width="0.8*" MaxWidth="125" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="Patient Code:" Style="{StaticResource PaperLabel}" />
      <Grid Grid.Row="0" Grid.Column="1" Margin="0,2">
        <TextBox Padding="6,5,28,5" Text="{Binding PatientCode, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsPatientLocked}"
                 ToolTip="Type a patient code or name to look the patient up (not available once a registration is loaded)">
          <TextBox.Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
              <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                  <Setter Property="Background" Value="{StaticResource ReadOnlyFillBrush}" />
                </Trigger>
              </Style.Triggers>
            </Style>          </TextBox.Style>
        </TextBox>
        <Path Style="{StaticResource SearchGlyph}" Visibility="{Binding CanLookUpPatient, Converter={StaticResource BoolToVis}}" />
          <Popup PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}" Placement="Bottom" StaysOpen="True"
                 MinWidth="260" Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
            <Popup.Style>
              <Style TargetType="Popup">
                <Setter Property="IsOpen" Value="False" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding HasPatientSuggestions}" Value="True" />
                      <Condition Binding="{Binding PlacementTarget.IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsOpen" Value="True" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Popup.Style>
            <Border Background="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="Already a patient? Click to use" Margin="8,5" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" Focusable="False">
                  <ItemsControl ItemsSource="{Binding PatientSuggestions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource SuggestionButton}" CommandParameter="{Binding}"
                                Command="{Binding DataContext.PickPatientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                          <StackPanel>
                            <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" />
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11">
                              <Run Text="{Binding PatientCode, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Sex, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Age, Mode=OneWay}" />
                            </TextBlock>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>
          </Popup>      </Grid>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="Age:" Style="{StaticResource PaperLabel}" />
      <TextBox Grid.Row="0" Grid.Column="4" Margin="0,2" Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Grid.Row="0" Grid.Column="5" Text="Sex:" Style="{StaticResource PaperLabel}" HorizontalAlignment="Right" />
      <ctl:ChoiceBox Grid.Row="0" Grid.Column="6" Margin="0,2" ItemsSource="{Binding Genders}" Text="{Binding Sex}" EditCommand="{Binding EditGenderListCommand}" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Patient Name:" Style="{StaticResource PaperLabel}" />
      <Grid Grid.Row="1" Grid.Column="1" Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" Padding="6,5,28,5" Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsPatientLocked}"
                 ToolTip="Type a patient name or code to look the patient up (not available once a registration is loaded)">
          <TextBox.Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
              <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                  <Setter Property="Background" Value="{StaticResource ReadOnlyFillBrush}" />
                </Trigger>
              </Style.Triggers>
            </Style>          </TextBox.Style>
        </TextBox>
        <Path Grid.Column="0" Style="{StaticResource SearchGlyph}" Visibility="{Binding CanLookUpPatient, Converter={StaticResource BoolToVis}}" />
        <Button Grid.Column="1" Content="Different patient" Margin="6,0,0,0" MinWidth="0" Padding="8,2" Command="{Binding ChangePatientCommand}"
                Visibility="{Binding HasPatient, Converter={StaticResource BoolToVis}}"
                ToolTip="Stop using this patient and type the details in (or look up another patient)" />
          <Popup PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}" Placement="Bottom" StaysOpen="True"
                 MinWidth="260" Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
            <Popup.Style>
              <Style TargetType="Popup">
                <Setter Property="IsOpen" Value="False" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding HasPatientSuggestions}" Value="True" />
                      <Condition Binding="{Binding PlacementTarget.IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsOpen" Value="True" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Popup.Style>
            <Border Background="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="Already a patient? Click to use" Margin="8,5" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" Focusable="False">
                  <ItemsControl ItemsSource="{Binding PatientSuggestions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource SuggestionButton}" CommandParameter="{Binding}"
                                Command="{Binding DataContext.PickPatientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                          <StackPanel>
                            <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" />
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11">
                              <Run Text="{Binding PatientCode, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Sex, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Age, Mode=OneWay}" />
                            </TextBlock>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>
          </Popup>      </Grid>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="Date Requested:" Style="{StaticResource PaperLabel}" />
      <DatePicker Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="3" Margin="0,2" SelectedDate="{Binding DateRequested}" />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="Company/Physician:" Style="{StaticResource PaperLabel}" />
      <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" IsEditable="True" ItemsSource="{Binding CompanyNames}"
                Text="{Binding CompanyOrPhysician, UpdateSourceTrigger=LostFocus}" ToolTip="Pick a company or type a physician's name" />
    </Grid>

  </StackPanel>
</UserControl>