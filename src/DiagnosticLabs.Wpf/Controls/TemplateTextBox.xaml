<UserControl x:Class="DiagnosticLabs.Wpf.Controls.TemplateTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiagnosticLabs.Wpf.Controls">
  <!-- A multi-line text box with its "Saved texts" dropdown quietly in the upper right corner. -->
  <Grid>
    <TextBox x:Name="Box" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6,5,118,5"
             Text="{Binding Text, RelativeSource={RelativeSource AncestorType=local:TemplateTextBox}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <local:TemplatePicker HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,18,0"
                          Options="{Binding Options, RelativeSource={RelativeSource AncestorType=local:TemplateTextBox}}"
                          EditCommand="{Binding EditCommand, RelativeSource={RelativeSource AncestorType=local:TemplateTextBox}}" />
  </Grid>
</UserControl>
