<UserControl x:Class="DiagnosticLabs.Wpf.Controls.ChoiceBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiagnosticLabs.Wpf.Controls">
  <UserControl.Resources>
    <!-- The "Edit entries..." row: set apart by a line, in the muted colour of the form's labels -->
    <DataTemplate DataType="{x:Type local:EditEntriesItem}">
      <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Margin="-4,4,-4,-2" Padding="4,5,4,1">
        <TextBlock Text="{Binding Text}" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" />
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <!-- Editable on purpose: a value typed here belongs to this record only and is not added to the list.
       The text is passed on as it changes (see ChoiceBox.xaml.cs), so whatever depends on the name, like a licence number, follows at once. -->
  <ComboBox x:Name="Combo" IsEditable="True" SelectionChanged="OnSelectionChanged" DropDownOpened="OnDropDownOpened" />
</UserControl>