<UserControl x:Class="DiagnosticLabs.Wpf.Controls.TemplatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiagnosticLabs.Wpf.Controls"
             xmlns:entries="clr-namespace:DiagnosticLabs.Application.Entries;assembly=DiagnosticLabs.Application">
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type entries:MultiLineEntry}">
      <TextBlock Text="{Binding Title}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:EditEntriesItem}">
      <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Margin="-4,4,-4,-2" Padding="4,5,4,1">
        <TextBlock Text="{Binding Text}" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" />
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <!-- "Saved texts": a dropdown of the titles of the reusable texts (the multi-line Entry Builder list); picking one fills the text box.
       The last row, "Edit saved texts...", opens the Entry Builder for the list. -->
  <Grid>
    <ComboBox x:Name="Combo" SelectionChanged="OnSelectionChanged"
              ToolTip="Insert one of the saved texts" />
    <TextBlock Margin="9,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource MutedTextBrush}"
               Text="{Binding Options.Items.Count, RelativeSource={RelativeSource AncestorType=local:TemplatePicker}, StringFormat='Saved texts ({0})'}" />
  </Grid>
</UserControl>