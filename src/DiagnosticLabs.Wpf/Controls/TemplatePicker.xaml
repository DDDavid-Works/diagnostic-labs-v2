<UserControl x:Class="DiagnosticLabs.Wpf.Controls.TemplatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiagnosticLabs.Wpf.Controls"
             xmlns:entries="clr-namespace:DiagnosticLabs.Application.Entries;assembly=DiagnosticLabs.Application">
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type entries:MultiLineEntry}">
      <TextBlock Text="{Binding Title}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:EditEntriesItem}">
      <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Margin="-4,4,-4,-2" Padding="4,5,4,1">
        <TextBlock Text="{Binding Text}" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic" />
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <!-- "Saved texts": a quiet link-like dropdown of the titles of the reusable texts (the multi-line Entry Builder list); picking one fills the text box.
       The last row, "Edit saved texts...", opens the Entry Builder for the list. It is meant to sit inside the corner of the text box (see TemplateTextBox). -->
  <ComboBox x:Name="Combo" SelectionChanged="OnSelectionChanged" ToolTip="Insert one of the saved texts" Cursor="Hand" Focusable="False">
    <ComboBox.Template>
      <ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="6,2">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="11" FontStyle="Italic" Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding Options.Items.Count, RelativeSource={RelativeSource AncestorType=local:TemplatePicker}, StringFormat='Saved texts ({0})'}" />
                    <Path Data="M 0,0 L 3.5,3.5 L 7,0" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1" Margin="5,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#EEF0F3" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>
          <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" HorizontalOffset="-110" StaysOpen="False" AllowsTransparency="True" Focusable="False">
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" MinWidth="200" MaxWidth="420" Padding="2,2,2,3">
              <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter />
              </ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate>
    </ComboBox.Template>
  </ComboBox>
</UserControl>