<?xml version="1.0" encoding="utf-8"?>
<!-- Release for the lab stations: self-contained, so a Windows 10/11 PC needs no .NET installed.
     Use tools/deploy/Publish-Release.ps1, which runs this profile and stamps the version. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <PublishDir>..\..\artifacts\publish\</PublishDir>
  </PropertyGroup>
</Project>
