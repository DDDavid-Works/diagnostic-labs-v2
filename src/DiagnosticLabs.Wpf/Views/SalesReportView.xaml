<UserControl x:Class="DiagnosticLabs.Wpf.Views.SalesReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icn="clr-namespace:DiagnosticLabs.Wpf.Controls"
             xmlns:vm="clr-namespace:DiagnosticLabs.Wpf.ViewModels"
             Loaded="OnLoaded">
  <Grid Margin="24,16,24,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Sales Report" Style="{StaticResource PageTitle}" Margin="0,0,0,12" />
    <StackPanel Grid.Row="1" HorizontalAlignment="Left" Width="560">
    <Border Background="White" Padding="20,16"
            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="Filters" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Date Requested" Style="{StaticResource PaperLabel}" VerticalAlignment="Center" />
        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding DateFrom}" Margin="0,0,0,10" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="to" Style="{StaticResource PaperLabel}" Margin="10,0,10,10" VerticalAlignment="Center" />
        <DatePicker Grid.Row="1" Grid.Column="3" SelectedDate="{Binding DateTo}" Margin="0,0,0,10" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Company" Style="{StaticResource PaperLabel}" VerticalAlignment="Center" />
        <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding Companies}" DisplayMemberPath="Name"
                  SelectedValuePath="Id" SelectedValue="{Binding CompanyId}" Margin="0,0,0,10" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Batch" Style="{StaticResource PaperLabel}" VerticalAlignment="Center" />
        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding Batches}" SelectedItem="{Binding Batch}" Margin="0,0,0,10"
                  IsEnabled="{Binding CanPickBatch}" ToolTip="Pick a company to choose one of its batches" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Payment" Style="{StaticResource PaperLabel}" VerticalAlignment="Center" />
        <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{x:Static vm:SalesReportViewModel.PaymentChoices}" DisplayMemberPath="Name" SelectedItem="{Binding Payment}"
                  ToolTip="Direct payments leave out what was charged to the company" />
      </Grid>
    </Border>

    <TextBlock Text="{Binding Message}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />

    <Button icn:ButtonIcon.Data="{StaticResource Icon.Print}" Content="Print" Padding="14,6" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding PrintCommand}"
            ToolTip="Preview the report and print it" />

    </StackPanel>
  </Grid>
</UserControl>
