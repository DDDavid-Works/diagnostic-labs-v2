<UserControl x:Class="DiagnosticLabs.Wpf.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icn="clr-namespace:DiagnosticLabs.Wpf.Controls"
             xmlns:vm="clr-namespace:DiagnosticLabs.Wpf.ViewModels"
             Loaded="OnLoaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- A result form of a registration: ticked and tinted once its result has been made -->
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,8,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="13" Padding="10,4" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Mark" Text="&#x25CB;" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsMade}" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverTintBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                <Setter TargetName="Mark" Property="Text" Value="&#x2714;" />
                <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource SuccessBrush}" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="24,16,24,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Today" Command="{Binding TodayCommand}" ToolTip="Today's registrations, no other filter" />
        <Button Content="All days" Margin="8,0,0,0" Command="{Binding AllDaysCommand}" ToolTip="Remove the date limit" />
        <Button icn:ButtonIcon.Data="{StaticResource Icon.Refresh}" Content="Refresh" Margin="8,0,0,0" Command="{Binding RefreshCommand}" ToolTip="Load the list again" />
      </StackPanel>
      <TextBlock Text="Registrations" Style="{StaticResource PageTitle}" />
    </DockPanel>

    <!-- Filters -->
    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="220" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Margin="0,0,10,0">
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="6,5,28,5"
                 ToolTip="A patient name, a patient code or a registration code" />
        <Path Style="{StaticResource SearchGlyph}" />
        <TextBlock Text="Patient name or registration code" IsHitTestVisible="False" Margin="8,0,30,0" VerticalAlignment="Center"
                   Foreground="{StaticResource MutedTextBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SearchText}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
      <ComboBox Grid.Column="1" Width="190" Margin="0,0,10,0" ItemsSource="{Binding Companies}" DisplayMemberPath="Name"
                SelectedValuePath="Id" SelectedValue="{Binding CompanyId}" ToolTip="Only one company" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0">
        <TextBlock Text="From" Style="{StaticResource PaperLabel}" Margin="0,0,6,0" />
        <DatePicker Width="140" SelectedDate="{Binding DateFrom}" />
        <TextBlock Text="To" Style="{StaticResource PaperLabel}" Margin="10,0,6,0" />
        <DatePicker Width="140" SelectedDate="{Binding DateTo}" />
      </StackPanel>
      <ComboBox Grid.Column="3" Width="160" ItemsSource="{x:Static vm:HomeViewModel.StatusChoices}" DisplayMemberPath="Name" SelectedItem="{Binding Status}"
                ToolTip="Unpaid registrations, or those with a result still to make" />
    </Grid>

    <!-- The registrations -->
    <Grid Grid.Row="2">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Margin="0,0,0,8" Padding="14,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="{Binding PatientName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding PatientName}" />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0">
                      <Run Text="{Binding Code, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding DateText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                               ToolTip="{Binding Details}" />
                  </StackPanel>

                  <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <Button icn:ButtonIcon.Data="{StaticResource Icon.Pay}" Content="Pay" HorizontalAlignment="Left" MinWidth="86" Padding="14,6" IsEnabled="{Binding CanPay}"
                            CommandParameter="{Binding}"
                            Command="{Binding DataContext.PayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" ToolTip="Open the payment of this registration" />
                    <TextBlock Text="{Binding PaymentText}" Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding PaymentState}" Value="Paid">
                              <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PaymentState}" Value="Charged">
                              <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PaymentState}" Value="Partial">
                              <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>

                  <ItemsControl Grid.Column="2" ItemsSource="{Binding Chips}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource ChipButton}" IsEnabled="{Binding CanOpen}" ToolTip="{Binding ToolTip}"
                                CommandParameter="{Binding}"
                                Command="{Binding DataContext.OpenChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0" Foreground="{StaticResource MutedTextBrush}"
                 Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVis}}" />
    </Grid>

    <!-- Paging -->
    <DockPanel Grid.Row="3" Margin="0,8,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Rows per page" Style="{StaticResource PaperLabel}" Margin="0,0,6,0" />
        <ComboBox Width="70" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button icn:ButtonIcon.Data="{StaticResource Icon.Previous}" Content="Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" />
        <Button icn:ButtonIcon.Data="{StaticResource Icon.Next}" icn:ButtonIcon.AtEnd="True" Content="Next" Margin="8,0,0,0" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" />
        <TextBlock Text="{Binding PageDisplay}" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
        <TextBlock Text="{Binding Message}" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}" />
      </StackPanel>
    </DockPanel>
  </Grid>
</UserControl>
