<Window x:Class="DiagnosticLabs.Wpf.Views.FormChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icn="clr-namespace:DiagnosticLabs.Wpf.Controls"
        Background="{StaticResource WindowBrush}" Width="460" SizeToContent="Height"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <!-- Asks which form a result is entered in: one wide button per form (the suggested one is the primary button), and Cancel. -->
  <StackPanel Margin="20,18,20,16">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,14" />
    <StackPanel x:Name="OptionPanel" />
    <Button HorizontalAlignment="Right" icn:ButtonIcon.Data="{StaticResource Icon.Cancel}" Content="Cancel" IsCancel="True" Margin="0,6,0,0" />
  </StackPanel>
</Window>
