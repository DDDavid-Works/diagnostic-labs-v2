<Window x:Class="DiagnosticLabs.Wpf.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change password" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="26,22,26,22">
    <TextBlock Text="Change password" Style="{StaticResource PageTitle}" />

    <Border Background="#FFF6DD" BorderBrush="#E8C766" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,14,0,0">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsForced}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock TextWrapping="Wrap"
                 Text="You are using a temporary password. Choose a new one to continue." />
    </Border>

    <TextBlock Text="Current password" Style="{StaticResource FieldLabel}" Margin="0,16,0,3" />
    <PasswordBox x:Name="OldBox" Padding="6,5" PasswordChanged="OldBox_OnPasswordChanged" />

    <TextBlock Text="New password" Style="{StaticResource FieldLabel}" />
    <PasswordBox x:Name="NewBox" Padding="6,5" PasswordChanged="NewBox_OnPasswordChanged" />

    <TextBlock Text="Confirm new password" Style="{StaticResource FieldLabel}" />
    <PasswordBox x:Name="ConfirmBox" Padding="6,5" PasswordChanged="ConfirmBox_OnPasswordChanged" />

    <TextBlock Text="{Binding Hint}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
    <TextBlock Text="{Binding Message}" Style="{StaticResource StatusText}" Margin="0,10,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Command="{Binding SaveCommand}" />
      <Button Content="{Binding CancelText}" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
