<Window x:Class="DiagnosticLabs.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiagnosticLabs.Wpf.ViewModels"
        xmlns:views="clr-namespace:DiagnosticLabs.Wpf.Views"
        Title="Diagnostic Labs" Width="1280" Height="700" MinWidth="1024" MinHeight="600" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CrudTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
    <DataTemplate DataType="{x:Type vm:CompanySetupViewModel}">
      <views:CompanySetupView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
      <views:PlaceholderView />
    </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,10" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Change password" Command="{Binding ChangePasswordCommand}" />
          <Button Content="Sign out" Margin="8,0,0,0" Click="SignOut_OnClick" />
        </StackPanel>
        <TextBlock Text="Diagnostic Labs" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Greeting}" VerticalAlignment="Center" Margin="18,0,0,0"
                   Foreground="{StaticResource MutedTextBrush}" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Left" Width="232" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Menu}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Expander Header="{Binding Name}" IsExpanded="True" Margin="6,4" FontWeight="SemiBold">
                <ItemsControl ItemsSource="{Binding Items}" FontWeight="Normal">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Name}" Style="{StaticResource MenuButton}"
                              Command="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <ContentControl Content="{Binding CurrentPage}" />
  </DockPanel>
</Window>
