<Window x:Class="DiagnosticLabs.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource WindowBrush}" Title="Diagnostic Labs - Sign in"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <StackPanel Margin="32">
    <Image Source="{Binding LogoImage}" MaxHeight="90" HorizontalAlignment="Left" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality"
           Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}" />
    <TextBlock Text="{Binding BrandName}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="{Binding BrandTagline}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
    <Separator Margin="0,16,0,18" />

    <TextBlock Text="Username" Margin="0,0,0,4" />
    <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
             Padding="6" Margin="0,0,0,12" />

    <TextBlock Text="Password" Margin="0,0,0,4" />
    <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_OnPasswordChanged"
                 Padding="6" Margin="0,0,0,12" />

    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B00020" TextWrapping="Wrap" Margin="0,0,0,12" />

    <Button Content="Sign in" Command="{Binding LoginCommand}" IsDefault="True" Padding="0,8" />
  </StackPanel>
</Window>
