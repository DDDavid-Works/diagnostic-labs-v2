<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DiagnosticLabs.Wpf.ViewModels"
                    xmlns:ctl="clr-namespace:DiagnosticLabs.Wpf.Controls"
                    xmlns:views="clr-namespace:DiagnosticLabs.Wpf.Views">

  <BooleanToVisibilityConverter x:Key="BoolToVis" />
  <views:InverseBooleanConverter x:Key="InverseBool" />

  <!-- Every maintenance screen is the shared CrudLayout plus its own list columns and form fields. -->

  <!-- ===================================================== Patients -->
  <DataTemplate DataType="{x:Type vm:PatientsViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Code" Binding="{Binding PatientCode}" Width="115" />
            <DataGridTextColumn Header="Name" Binding="{Binding PatientName}" Width="*" />
            <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="105" />
            <DataGridTextColumn Header="Gender" Binding="{Binding Sex}" Width="70" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Patient code" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding PatientCode, Mode=OneWay}" IsReadOnly="True" Background="#EEF0F3" />

          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Date of birth" Style="{StaticResource FieldLabel}" />
              <DatePicker SelectedDate="{Binding DateOfBirth}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Age" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Age, Mode=OneWay}" IsReadOnly="True" Background="#EEF0F3" />
            </StackPanel>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Gender" Style="{StaticResource FieldLabel}" />
              <ctl:ChoiceBox ItemsSource="{Binding Genders}" Text="{Binding Sex}" EditCommand="{Binding EditGenderListCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Civil status" Style="{StaticResource FieldLabel}" />
              <ctl:ChoiceBox ItemsSource="{Binding CivilStatuses}" Text="{Binding CivilStatus}" EditCommand="{Binding EditCivilStatusListCommand}" />
            </StackPanel>
          </Grid>

          <TextBlock Text="Address" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />

          <TextBlock Text="Contact numbers" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ContactNumbers, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Patient Registration -->
  <DataTemplate DataType="{x:Type vm:RegistrationsViewModel}">
    <ctl:CrudLayout FormMaxWidth="1280">
      <ctl:CrudLayout.SearchFilters>
        <StackPanel Margin="0,0,0,8">
          <ComboBox ItemsSource="{Binding FilterCompanies}" SelectedValuePath="Id" DisplayMemberPath="Name"
                    SelectedValue="{Binding CompanyFilterId}" ToolTip="Only show registrations of one company" />
          <DockPanel Margin="0,6,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Clear filters" Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}" />
            <DatePicker SelectedDate="{Binding DateFilter}" ToolTip="Only show registrations of one day" />
          </DockPanel>
        </StackPanel>
      </ctl:CrudLayout.SearchFilters>

      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Code" Binding="{Binding RegistrationCode}" Width="138" />
            <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*" />
            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd MMM yy'}" Width="75" />
            <DataGridTextColumn Header="Price" Binding="{Binding AmountDue, StringFormat=N2}" Width="75" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>

      <ctl:CrudLayout.FooterContent>
        <StackPanel Orientation="Horizontal">
          <Button Content="Save &amp; New" Command="{Binding SaveAndNewCommand}" IsEnabled="{Binding CanSave}"
                  ToolTip="Save, then start the next patient (Ctrl+S saves)" />
          <Button Content="Pay now" Margin="8,0,0,0" Command="{Binding PayNowCommand}"
                  Visibility="{Binding CanPayNow, Converter={StaticResource BoolToVis}}"
                  ToolTip="Open Payments with this registration ready to pay" />
        </StackPanel>
      </ctl:CrudLayout.FooterContent>

      <ctl:CrudLayout.FormContent>
        <!-- Three blocks side by side (they fit a 1366-wide screen with the menu open); on a narrow window they wrap under each other. -->
        <WrapPanel Orientation="Horizontal">

          <!-- Registration -->
          <StackPanel Width="324" Margin="0,0,14,10">
            <TextBlock Text="Registration" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="165" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Registration code" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding RegistrationCode, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" Background="#EEF0F3" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding Date}" />
              </StackPanel>
            </Grid>

            <TextBlock Text="Company" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Companies}" SelectedValuePath="Id" DisplayMemberPath="Name"
                      SelectedValue="{Binding CompanyChoiceId}" />

            <TextBlock Text="Batch" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Batches}" Text="{Binding BatchName, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True" ToolTip="Pick a batch used before or type a new one" />

            <TextBlock Text="Package" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Packages}" SelectedValuePath="Id" DisplayMemberPath="Name"
                      SelectedValue="{Binding PackageChoiceId}"
                      ToolTip="Picking a package fills in its services and price" />
          </StackPanel>

          <!-- Patient -->
          <StackPanel Width="324" Margin="0,0,14,10">
            <DockPanel Margin="0,4,0,0">
              <Button DockPanel.Dock="Right" Content="Different patient" Padding="8,2" MinWidth="0"
                      Command="{Binding ChangePatientCommand}"
                      Visibility="{Binding CanChangePatient, Converter={StaticResource BoolToVis}}"
                      ToolTip="Stop using this existing patient and type in another one" />
              <TextBlock Text="Patient" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="Patient code" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding PatientCode, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" Background="#EEF0F3" />

            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
            <Grid>
              <TextBox Tag="Autofocus" Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Start typing: patients already on file are offered below" />
              <Popup PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}" Placement="Bottom" StaysOpen="True"
                     Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
                <Popup.Style>
                  <Style TargetType="Popup">
                    <Setter Property="IsOpen" Value="False" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding HasSuggestions}" Value="True" />
                          <Condition Binding="{Binding PlacementTarget.IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="IsOpen" Value="True" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Popup.Style>
                <Border Background="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="Already registered? Click to reuse" Margin="8,5" FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Suggestions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                         <Button Style="{StaticResource SuggestionButton}" Command="{Binding DataContext.PickSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                          <StackPanel>
                            <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" />
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11">
                              <Run Text="{Binding PatientCode, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Sex, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Age, Mode=OneWay}" />
                            </TextBlock>
                          </StackPanel>
                         </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Border>
              </Popup>
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Date of birth" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding DateOfBirth}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Age" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsAgeReadOnly}"
                         ToolTip="Computed from the date of birth; type the age here when the birth date is unknown">
                  <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                      <Style.Triggers>
                        <Trigger Property="IsReadOnly" Value="True">
                          <Setter Property="Background" Value="#EEF0F3" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </TextBox.Style>
                </TextBox>
              </StackPanel>
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Gender" Style="{StaticResource FieldLabel}" />
                <ctl:ChoiceBox ItemsSource="{Binding Genders}" Text="{Binding Sex}" EditCommand="{Binding EditGenderListCommand}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Civil status" Style="{StaticResource FieldLabel}" />
                <ctl:ChoiceBox ItemsSource="{Binding CivilStatuses}" Text="{Binding CivilStatus}" EditCommand="{Binding EditCivilStatusListCommand}" />
              </StackPanel>
            </Grid>

            <TextBlock Text="Address" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                     TextWrapping="Wrap" MinHeight="48" VerticalScrollBarVisibility="Auto" />

            <TextBlock Text="Contact numbers" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding ContactNumbers, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>

          <!-- Services -->
          <StackPanel Width="324" Margin="0,0,14,10">
            <DockPanel Margin="0,4,0,6">
              <Button DockPanel.Dock="Right" Content="+ Add services" Command="{Binding ChooseServicesCommand}"
                      ToolTip="Open the list of services; tick the ones for this patient" />
              <TextBlock Text="Services" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
            </DockPanel>

            <DataGrid ItemsSource="{Binding Services}" IsReadOnly="False" Height="226" CanUserSortColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2, UpdateSourceTrigger=LostFocus}" Width="90" />
                <DataGridTemplateColumn Width="42">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="&#x2715;" MinWidth="28" Padding="0,2" ToolTip="Remove this service"
                              Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                              CommandParameter="{Binding}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="No services yet. Press + Add services." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Services.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Price" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding AmountDue, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                       FontSize="15" FontWeight="SemiBold" HorizontalContentAlignment="Right"
                       ToolTip="Follows the total of the services until you type a price" />
            </Grid>
          </StackPanel>
        </WrapPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Payments -->
  <DataTemplate DataType="{x:Type vm:PaymentsViewModel}">
    <ctl:CrudLayout FormMaxWidth="900">
      <ctl:CrudLayout.SearchFilters>
        <StackPanel Margin="0,0,0,8">
          <ComboBox ItemsSource="{Binding FilterCompanies}" SelectedValuePath="Id" DisplayMemberPath="Name"
                    SelectedValue="{Binding CompanyFilterId}" ToolTip="Only show payments of one company" />
          <DockPanel Margin="0,6,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Clear filters" Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}" />
            <DatePicker SelectedDate="{Binding DateFilter}" ToolTip="Only show payments of one day" />
          </DockPanel>
        </StackPanel>
      </ctl:CrudLayout.SearchFilters>

      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate, StringFormat='dd MMM yy'}" Width="75" />
            <DataGridTextColumn Header="Registration" Binding="{Binding RegistrationCode}" Width="138" />
            <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*" />
            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="75" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>

      <ctl:CrudLayout.FooterContent>
        <Button Content="Save &amp; New" Command="{Binding SaveAndNewCommand}" IsEnabled="{Binding CanSave}"
                ToolTip="Save, then start the next payment (Ctrl+S saves)" />
      </ctl:CrudLayout.FooterContent>

      <ctl:CrudLayout.FormContent>
        <WrapPanel Orientation="Horizontal">

          <!-- The registration being paid -->
          <StackPanel Width="420" Margin="0,0,24,10">
            <TextBlock Text="Registration" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0" />

            <TextBlock Text="Registration code or patient name" Style="{StaticResource FieldLabel}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0">
                <TextBox Tag="Autofocus" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Type a code and press Enter, or start typing a name and pick the registration">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding FindCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
                <Popup PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}" Placement="Bottom" StaysOpen="True"
                       Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
                  <Popup.Style>
                    <Style TargetType="Popup">
                      <Setter Property="IsOpen" Value="False" />
                      <Style.Triggers>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding HasSuggestions}" Value="True" />
                            <Condition Binding="{Binding PlacementTarget.IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="IsOpen" Value="True" />
                        </MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Popup.Style>
                  <Border Background="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Suggestions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                         <Button Style="{StaticResource SuggestionButton}" Command="{Binding DataContext.PickSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" />
                              <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11">
                                <Run Text="{Binding RegistrationCode, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Date, Mode=OneWay, StringFormat='dd MMM yy'}" />
                              </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,2,0"
                                       Text="{Binding Balance, StringFormat='Balance {0:N2}'}" Foreground="{StaticResource MutedTextBrush}" />
                          </Grid>
                         </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <Button Grid.Column="1" Content="Find" Margin="8,0,0,0" MinWidth="64" Command="{Binding FindCommand}" />
            </Grid>

            <StackPanel Visibility="{Binding HasRegistration, Converter={StaticResource BoolToVis}}">
              <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Content="Different registration" Padding="8,2" MinWidth="0" VerticalAlignment="Top"
                        Command="{Binding ChangeRegistrationCommand}"
                        Visibility="{Binding CanChangeRegistration, Converter={StaticResource BoolToVis}}" />
                <StackPanel>
                  <TextBlock Text="{Binding Registration.PatientName}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                  <TextBlock Foreground="{StaticResource MutedTextBrush}">
                    <Run Text="{Binding Registration.RegistrationCode, Mode=OneWay}" /><Run Text="  -  " /><Run Text="{Binding Registration.Date, Mode=OneWay, StringFormat='dd MMM yyyy'}" />
                  </TextBlock>
                  <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding Registration.CompanyName}" />
                </StackPanel>
              </DockPanel>

              <TextBlock Text="Services" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
              <DataGrid ItemsSource="{Binding ServiceLines}" Height="150" CanUserSortColumns="False" IsHitTestVisible="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="*" />
                  <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="90" />
                </DataGrid.Columns>
              </DataGrid>
              <Grid Margin="0,8,0,0">
                <TextBlock Text="Price" FontWeight="SemiBold" FontSize="15" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding Price, StringFormat=N2}" FontWeight="SemiBold" FontSize="15" />
              </Grid>
            </StackPanel>
          </StackPanel>

          <!-- The payment -->
          <StackPanel Width="360" Margin="0,0,0,10" IsEnabled="{Binding HasRegistration}">
            <TextBlock Text="Payment" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0" />

            <TextBlock Text="Payment date" Style="{StaticResource FieldLabel}" />
            <DatePicker SelectedDate="{Binding PaymentDate}" />

            <TextBlock Text="Discount" Style="{StaticResource FieldLabel}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox ItemsSource="{Binding Discounts}" SelectedValuePath="Id" DisplayMemberPath="Name"
                        SelectedValue="{Binding SelectedDiscountId}" ToolTip="PWD, Senior Citizen... or type a one-off discount below" />
              <ComboBox Grid.Column="1" Width="110" Margin="8,0,0,0" ItemsSource="{Binding DiscountChoices}" DisplayMemberPath="Label"
                        SelectedItem="{Binding SelectedChoice}" ToolTip="This discount has more than one option"
                        Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}" />
            </Grid>
            <Grid Margin="0,6,0,0" IsEnabled="{Binding CanTypeDiscount}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding DiscountValue, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                       HorizontalContentAlignment="Right" ToolTip="Leave at 0 for no discount" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <RadioButton Content="Amount" GroupName="DiscountType" Margin="0,0,12,0"
                             IsChecked="{Binding DiscountIsPercentage, Converter={StaticResource InverseBool}}" />
                <RadioButton Content="Percentage" GroupName="DiscountType" IsChecked="{Binding DiscountIsPercentage}" />
              </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,0">
              <TextBlock Text="Discount total" Foreground="{StaticResource MutedTextBrush}" />
              <TextBlock HorizontalAlignment="Right" Text="{Binding DiscountTotal, StringFormat=N2}" />
            </Grid>
            <Grid Margin="0,6,0,0">
              <TextBlock Text="Amount due" FontWeight="SemiBold" FontSize="16" />
              <TextBlock HorizontalAlignment="Right" Text="{Binding AmountDue, StringFormat=N2}" FontWeight="SemiBold" FontSize="16" />
            </Grid>
            <Grid Margin="0,6,0,0">
              <TextBlock Text="Already paid" Foreground="{StaticResource MutedTextBrush}" />
              <TextBlock HorizontalAlignment="Right" Text="{Binding Paid, StringFormat=N2}" />
            </Grid>
            <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Margin="0,10,0,0" />

            <DockPanel Margin="0,10,0,3">
              <Button DockPanel.Dock="Right" Content="Pay balance" Padding="8,2" MinWidth="0" Command="{Binding PayBalanceCommand}"
                      ToolTip="Fill in what is still owed" />
              <TextBlock Text="Payment amount" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <TextBox Text="{Binding PaymentAmount, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditAmount}"
                     FontSize="20" FontWeight="SemiBold" HorizontalContentAlignment="Right" />

            <Grid Margin="0,10,0,0">
              <TextBlock Text="Balance after this payment" Foreground="{StaticResource MutedTextBrush}" />
              <TextBlock HorizontalAlignment="Right" Text="{Binding BalanceAfter, StringFormat=N2}" FontWeight="SemiBold" />
            </Grid>

            <CheckBox Content="Charge to the company (no payment now)" IsChecked="{Binding IsCharge}" Margin="0,12,0,0"
                      ToolTip="Marks the registration as billed to its company and settles the balance" />
            <TextBlock Text="{Binding RegistrationNote}" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </WrapPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Stool/Fecalysis -->
  <DataTemplate DataType="{x:Type vm:StoolFecalysisViewModel}">
    <ctl:CrudLayout FormMaxWidth="940">
      <ctl:CrudLayout.SearchFilters>
        <DockPanel Margin="0,0,0,8" LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="Clear filters" Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}" />
          <DatePicker SelectedDate="{Binding DateFilter}" ToolTip="Only show results of one day" />
        </DockPanel>
      </ctl:CrudLayout.SearchFilters>

      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd MMM yy'}" Width="75" />
            <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*" />
            <DataGridTextColumn Header="Registration" Binding="{Binding RegistrationCode}" Width="138" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>

      <ctl:CrudLayout.FooterContent>
        <StackPanel Orientation="Horizontal">
          <Button Content="Save &amp; New" Command="{Binding SaveAndNewCommand}" IsEnabled="{Binding CanSave}"
                  ToolTip="Save, then start the next result (Ctrl+S saves)" />
          <Button Content="Print" Margin="8,0,0,0" Command="{Binding PrintCommand}"
                  ToolTip="Save, then open the print preview" />
          <Button Content="Reset to defaults" Margin="8,0,0,0" Command="{Binding ResetToDefaultsCommand}"
                  Visibility="{Binding CanResetToDefaults, Converter={StaticResource BoolToVis}}"
                  ToolTip="Put the saved defaults back into the result fields" />
          <Button Content="Defaults" Margin="8,0,0,0" Command="{Binding EnterDefaultsCommand}"
                  Visibility="{Binding ShowDefaultsButton, Converter={StaticResource BoolToVis}}"
                  ToolTip="Set the values every new result starts with (administrators)" />
        </StackPanel>
      </ctl:CrudLayout.FooterContent>

      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <ctl:LabResultTop />

          <!-- The result box of the paper form: Color and Consistency in four cells, then Result under a line -->
          <Border Margin="0,6,0,0" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="1" Background="White">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="6,3,14,3">
                  <TextBlock Text="Color:" Style="{StaticResource PaperLabel}" />
                </Border>
                <Border Grid.Column="1" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="4,2">
                  <ctl:ChoiceBox ItemsSource="{Binding Colors}" Text="{Binding Color}" EditCommand="{Binding EditColorListCommand}" />
                </Border>
                <Border Grid.Column="2" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="6,3,14,3">
                  <TextBlock Text="Consistency:" Style="{StaticResource PaperLabel}" />
                </Border>
                <Border Grid.Column="3" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,0,1" Padding="4,2">
                  <ctl:ChoiceBox ItemsSource="{Binding Consistencies}" Text="{Binding Consistency}" EditCommand="{Binding EditConsistencyListCommand}" />
                </Border>
              </Grid>
              <DockPanel Grid.Row="1" Margin="6,3,6,6">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                  <ctl:TemplatePicker DockPanel.Dock="Right" Width="230" Options="{Binding ResultTemplates}" EditCommand="{Binding EditResultTemplatesCommand}" />
                  <TextBlock Text="Result:" Style="{StaticResource PaperLabel}" />
                </DockPanel>
                <TextBox Text="{Binding Result, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="46" MaxHeight="90" VerticalScrollBarVisibility="Auto" />
              </DockPanel>
            </Grid>
          </Border>
          <ctl:LabResultBottom />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>
  <!-- ===================================================== Companies -->
  <DataTemplate DataType="{x:Type vm:CompaniesViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding CompanyName}" Width="*" />
            <DataGridTextColumn Header="Contact person" Binding="{Binding ContactPerson}" Width="150" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Address" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />

          <TextBlock Text="Contact numbers" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ContactNumbers, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Contact person" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Departments -->
  <DataTemplate DataType="{x:Type vm:DepartmentsViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding DepartmentName}" Width="180" />
            <DataGridTextColumn Header="Description" Binding="{Binding DepartmentDescription}" Width="*" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding DepartmentName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding DepartmentDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Item locations -->
  <DataTemplate DataType="{x:Type vm:ItemLocationsViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding ItemLocationName}" Width="*" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ItemLocationName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Services -->
  <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding ServiceName}" Width="140" />
            <DataGridTextColumn Header="Description" Binding="{Binding ServiceDescription}" Width="*" />
            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="90">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextAlignment" Value="Right" />
                  <Setter Property="Margin" Value="0,0,6,0" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ServiceDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />
          <TextBlock Text="Price" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Price, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Items (with stock per location) -->
  <DataTemplate DataType="{x:Type vm:ItemsViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding ItemName}" Width="*" />
            <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat=N2}" Width="85" />
            <DataGridTextColumn Header="In stock" Binding="{Binding TotalQuantity, StringFormat=N2}" Width="85" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Cost" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Cost, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />

          <TextBlock Text="Quantities by location" Style="{StaticResource FieldLabel}" Margin="0,16,0,3" />
          <DataGrid ItemsSource="{Binding Quantities}" SelectedItem="{Binding SelectedQuantity}" IsReadOnly="False"
                    Height="170" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Location" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding DataContext.Locations, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                              SelectedValuePath="Id" DisplayMemberPath="Name"
                              SelectedValue="{Binding ItemLocationId, UpdateSourceTrigger=PropertyChanged}"
                              BorderThickness="0" Background="Transparent" Padding="4,2" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Width="90" />
            </DataGrid.Columns>
          </DataGrid>
          <DockPanel Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="+" MinWidth="36" Command="{Binding AddQuantityCommand}" ToolTip="Add a location" />
            <Button DockPanel.Dock="Left" Content="-" MinWidth="36" Margin="6,0,0,0" Command="{Binding RemoveQuantityCommand}" ToolTip="Remove the selected row" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
              <Run Text="Total: " Foreground="{StaticResource MutedTextBrush}" /><Run Text="{Binding TotalQuantity, Mode=OneWay, StringFormat=N2}" FontWeight="SemiBold" />
            </TextBlock>
          </DockPanel>
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Discounts (options: amount or percentage) -->
  <DataTemplate DataType="{x:Type vm:DiscountsViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding DiscountName}" Width="170" />
            <DataGridTextColumn Header="Description" Binding="{Binding DiscountDescription}" Width="*" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding DiscountName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding DiscountDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />

          <DockPanel Margin="0,16,0,3">
            <Button DockPanel.Dock="Right" Content="+ Add option" Command="{Binding AddLineCommand}"
                    ToolTip="Add another amount or percentage this discount can be given as" />
            <TextBlock Text="Options (each one is an amount or a percentage)" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
          </DockPanel>
          <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Background="White" MinHeight="60">
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="8,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" Content="Amount" VerticalAlignment="Center" Margin="0,0,14,0"
                                 IsChecked="{Binding IsPercentage, Converter={StaticResource InverseBool}}" />
                    <RadioButton Grid.Column="1" Content="Percentage" VerticalAlignment="Center" Margin="0,0,14,0"
                                 IsChecked="{Binding IsPercentage}" />
                    <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                             HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="&#x2715;" MinWidth="28" Padding="0,2" Margin="8,0,0,0" ToolTip="Remove this option"
                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <TextBlock Text="No options yet. Press + Add option." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Lines.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Packages -->
  <DataTemplate DataType="{x:Type vm:PackagesViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding PackageName}" Width="*" />
            <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="130" />
            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="85" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding PackageName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding PackageDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="50" VerticalScrollBarVisibility="Auto" />

          <TextBlock Text="Company" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding Companies}" SelectedValuePath="Id" DisplayMemberPath="Name"
                    SelectedValue="{Binding CompanyChoiceId}" />

          <TextBlock Text="Package price" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Price, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                   ToolTip="Follows the total of the included services until you type a price" />

          <DockPanel Margin="0,16,0,4">
            <Button DockPanel.Dock="Right" Content="+ Add services" Command="{Binding ChooseServicesCommand}"
                    ToolTip="Open the list of services; tick the ones in this package" />
            <TextBlock Text="Included services" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
          </DockPanel>
          <DataGrid ItemsSource="{Binding Services}" IsReadOnly="False" Height="190" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" IsReadOnly="True" Width="*" />
              <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2, UpdateSourceTrigger=LostFocus}" Width="90" />
              <DataGridTemplateColumn Width="42">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="&#x2715;" MinWidth="28" Padding="0,2" ToolTip="Remove this service"
                            Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="No services yet. Press + Add services." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Services.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Users (with the permission grid) -->
  <DataTemplate DataType="{x:Type vm:UsersViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="User name" Binding="{Binding Username}" Width="110" />
            <DataGridTextColumn Header="Full name" Binding="{Binding FullName}" Width="*" />
            <DataGridCheckBoxColumn Header="Admin" Binding="{Binding IsAdmin}" Width="55" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
            <DataGridCheckBoxColumn Header="Locked" Binding="{Binding IsLocked}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="User name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Full name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

          <CheckBox Content="Administrator (can open everything, including Management and Settings)"
                    IsChecked="{Binding IsAdmin}" Margin="0,14,0,0" />

          <!-- New user: the first, temporary password -->
          <StackPanel Visibility="{Binding CanSetTemporaryPassword, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Temporary password" Style="{StaticResource FieldLabel}" Margin="0,14,0,3" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding TemporaryPassword, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
              <Button Grid.Column="1" Content="Generate" Margin="6,0,0,0" Command="{Binding GeneratePasswordCommand}" />
            </Grid>
            <TextBlock Text="The user must choose their own password the first time they sign in."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>

          <!-- Existing user: status, unlock and password reset -->
          <Border Margin="0,16,0,0" Padding="12,8,12,12" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                  CornerRadius="3" Background="White"
                  Visibility="{Binding CanManageExisting, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Text="Account" FontWeight="SemiBold" />
              <TextBlock Text="{Binding AccountStatus}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
              <Button Content="Unlock account" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding UnlockCommand}"
                      Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />

              <TextBlock Text="Reset password" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding TemporaryPassword, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                <Button Grid.Column="1" Content="Generate" Margin="6,0,0,0" Command="{Binding GeneratePasswordCommand}" />
                <Button Grid.Column="2" Content="Reset" Margin="6,0,0,0" Command="{Binding ResetPasswordCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Permissions: one row per module -->
          <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowPermissions, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Permissions" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="Tick Access to let the user open a module; Access alone means view only."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />

            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox ItemsSource="{Binding UserOptions}" DisplayMemberPath="Name" SelectedItem="{Binding CopyFromUser}" />
              <Button Grid.Column="1" Content="Copy from this user" Margin="6,0,0,0" Command="{Binding CopyPermissionsCommand}"
                      ToolTip="Fill the grid with another user's permissions (press Save to keep them)" />
            </Grid>

            <ItemsControl ItemsSource="{Binding PermissionGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,10,0,0">
                    <Grid Background="#E9EDF3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" Margin="8,4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="All" Padding="8,1" MinWidth="0" Margin="10,0,0,0" Command="{Binding SelectAllCommand}"
                                ToolTip="Give access to every module in this group" />
                        <Button Content="None" Padding="8,1" MinWidth="0" Margin="4,0,0,0" Command="{Binding ClearAllCommand}"
                                ToolTip="Remove access to every module in this group" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="Access" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                      <TextBlock Grid.Column="2" Text="Create" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                      <TextBlock Grid.Column="3" Text="Edit" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                      <TextBlock Grid.Column="4" Text="Delete" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                      <TextBlock Grid.Column="5" Text="Print" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Background="White" Height="28">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="52" />
                              <ColumnDefinition Width="52" />
                              <ColumnDefinition Width="52" />
                              <ColumnDefinition Width="52" />
                              <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ModuleName}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding HasAccess}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="2" IsChecked="{Binding AllowCreate}" IsEnabled="{Binding SupportsCreate}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="3" IsChecked="{Binding AllowEdit}" IsEnabled="{Binding SupportsEdit}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="4" IsChecked="{Binding AllowDelete}" IsEnabled="{Binding SupportsDelete}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="5" IsChecked="{Binding AllowPrint}" IsEnabled="{Binding SupportsPrint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>
</ResourceDictionary>
