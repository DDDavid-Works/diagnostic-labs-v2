<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DiagnosticLabs.Wpf.ViewModels"
                    xmlns:ctl="clr-namespace:DiagnosticLabs.Wpf.Controls">

  <BooleanToVisibilityConverter x:Key="BoolToVis" />

  <!-- Every maintenance screen is the shared CrudLayout plus its own list columns and form fields. -->

  <!-- ===================================================== Patients -->
  <DataTemplate DataType="{x:Type vm:PatientsViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Code" Binding="{Binding PatientCode}" Width="115" />
            <DataGridTextColumn Header="Name" Binding="{Binding PatientName}" Width="*" />
            <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="105" />
            <DataGridTextColumn Header="Gender" Binding="{Binding Sex}" Width="70" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Patient code" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding PatientCode, Mode=OneWay}" IsReadOnly="True" Background="#EEF0F3" />

          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Date of birth" Style="{StaticResource FieldLabel}" />
              <DatePicker SelectedDate="{Binding DateOfBirth}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Age" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Age, Mode=OneWay}" IsReadOnly="True" Background="#EEF0F3" />
            </StackPanel>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Gender" Style="{StaticResource FieldLabel}" />
              <ctl:ChoiceBox ItemsSource="{Binding Genders}" Text="{Binding Sex}" EditCommand="{Binding EditGenderListCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Civil status" Style="{StaticResource FieldLabel}" />
              <ctl:ChoiceBox ItemsSource="{Binding CivilStatuses}" Text="{Binding CivilStatus}" EditCommand="{Binding EditCivilStatusListCommand}" />
            </StackPanel>
          </Grid>

          <TextBlock Text="Address" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />

          <TextBlock Text="Contact numbers" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ContactNumbers, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Companies -->
  <DataTemplate DataType="{x:Type vm:CompaniesViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding CompanyName}" Width="*" />
            <DataGridTextColumn Header="Contact person" Binding="{Binding ContactPerson}" Width="150" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="This is a system record and can not be changed." Foreground="{StaticResource MutedTextBrush}"
                     Margin="0,10,0,0" TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSystem}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Address" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />

          <TextBlock Text="Contact numbers" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ContactNumbers, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Contact person" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Departments -->
  <DataTemplate DataType="{x:Type vm:DepartmentsViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding DepartmentName}" Width="180" />
            <DataGridTextColumn Header="Description" Binding="{Binding DepartmentDescription}" Width="*" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding DepartmentName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding DepartmentDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Item locations -->
  <DataTemplate DataType="{x:Type vm:ItemLocationsViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding ItemLocationName}" Width="*" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ItemLocationName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Services -->
  <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding ServiceName}" Width="140" />
            <DataGridTextColumn Header="Description" Binding="{Binding ServiceDescription}" Width="*" />
            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="90">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextAlignment" Value="Right" />
                  <Setter Property="Margin" Value="0,0,6,0" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ServiceDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />
          <TextBlock Text="Price" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Price, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Items (with stock per location) -->
  <DataTemplate DataType="{x:Type vm:ItemsViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding ItemName}" Width="*" />
            <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat=N2}" Width="85" />
            <DataGridTextColumn Header="In stock" Binding="{Binding TotalQuantity, StringFormat=N2}" Width="85" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Cost" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Cost, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />

          <TextBlock Text="Quantities by location" Style="{StaticResource FieldLabel}" Margin="0,16,0,3" />
          <DataGrid ItemsSource="{Binding Quantities}" SelectedItem="{Binding SelectedQuantity}" IsReadOnly="False"
                    Height="170" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Location" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding DataContext.Locations, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                              SelectedValuePath="Id" DisplayMemberPath="Name"
                              SelectedValue="{Binding ItemLocationId, UpdateSourceTrigger=PropertyChanged}"
                              BorderThickness="0" Background="Transparent" Padding="4,2" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Width="90" />
            </DataGrid.Columns>
          </DataGrid>
          <DockPanel Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="+" MinWidth="36" Command="{Binding AddQuantityCommand}" ToolTip="Add a location" />
            <Button DockPanel.Dock="Left" Content="-" MinWidth="36" Margin="6,0,0,0" Command="{Binding RemoveQuantityCommand}" ToolTip="Remove the selected row" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
              <Run Text="Total: " Foreground="{StaticResource MutedTextBrush}" /><Run Text="{Binding TotalQuantity, Mode=OneWay, StringFormat=N2}" FontWeight="SemiBold" />
            </TextBlock>
          </DockPanel>
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Discounts (options: amount or percentage) -->
  <DataTemplate DataType="{x:Type vm:DiscountsViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding DiscountName}" Width="170" />
            <DataGridTextColumn Header="Description" Binding="{Binding DiscountDescription}" Width="*" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding DiscountName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding DiscountDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />

          <TextBlock Text="Options (fill in an amount or a percentage, not both)" Style="{StaticResource FieldLabel}" Margin="0,16,0,3" />
          <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" IsReadOnly="False"
                    Height="170" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Amount" Binding="{Binding Amount, UpdateSourceTrigger=LostFocus}" Width="*" />
              <DataGridTextColumn Header="Percentage (%)" Binding="{Binding Percentage, UpdateSourceTrigger=LostFocus}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="+" MinWidth="36" Command="{Binding AddLineCommand}" ToolTip="Add an option" />
            <Button Content="-" MinWidth="36" Margin="6,0,0,0" Command="{Binding RemoveLineCommand}" ToolTip="Remove the selected option" />
          </StackPanel>
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Packages -->
  <DataTemplate DataType="{x:Type vm:PackagesViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding PackageName}" Width="*" />
            <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="130" />
            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="85" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding PackageName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding PackageDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="50" VerticalScrollBarVisibility="Auto" />

          <TextBlock Text="Company" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding Companies}" SelectedValuePath="Id" DisplayMemberPath="Name"
                    SelectedValue="{Binding CompanyChoiceId}" />

          <TextBlock Text="Package price" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Price, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                   ToolTip="Follows the total of the included services until you type a price" />

          <DockPanel Margin="0,16,0,4">
            <Button DockPanel.Dock="Right" Content="+ Add services" Command="{Binding ChooseServicesCommand}"
                    ToolTip="Open the list of services; tick the ones in this package" />
            <TextBlock Text="Included services" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
          </DockPanel>
          <DataGrid ItemsSource="{Binding Services}" IsReadOnly="False" Height="190" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" IsReadOnly="True" Width="*" />
              <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2, UpdateSourceTrigger=LostFocus}" Width="90" />
              <DataGridTemplateColumn Width="42">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="&#x2715;" MinWidth="28" Padding="0,2" ToolTip="Remove this service"
                            Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="No services yet. Press + Add services." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Services.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Users (with the permission grid) -->
  <DataTemplate DataType="{x:Type vm:UsersViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="User name" Binding="{Binding Username}" Width="110" />
            <DataGridTextColumn Header="Full name" Binding="{Binding FullName}" Width="*" />
            <DataGridCheckBoxColumn Header="Admin" Binding="{Binding IsAdmin}" Width="55" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
            <DataGridCheckBoxColumn Header="Locked" Binding="{Binding IsLocked}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="User name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Full name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

          <CheckBox Content="Administrator (can open everything, including Management and Settings)"
                    IsChecked="{Binding IsAdmin}" Margin="0,14,0,0" />

          <!-- New user: the first, temporary password -->
          <StackPanel Visibility="{Binding CanSetTemporaryPassword, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Temporary password" Style="{StaticResource FieldLabel}" Margin="0,14,0,3" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding TemporaryPassword, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
              <Button Grid.Column="1" Content="Generate" Margin="6,0,0,0" Command="{Binding GeneratePasswordCommand}" />
            </Grid>
            <TextBlock Text="The user must choose their own password the first time they sign in."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>

          <!-- Existing user: status, unlock and password reset -->
          <Border Margin="0,16,0,0" Padding="12,8,12,12" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                  CornerRadius="3" Background="White"
                  Visibility="{Binding CanManageExisting, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Text="Account" FontWeight="SemiBold" />
              <TextBlock Text="{Binding AccountStatus}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
              <Button Content="Unlock account" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding UnlockCommand}"
                      Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />

              <TextBlock Text="Reset password" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding TemporaryPassword, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                <Button Grid.Column="1" Content="Generate" Margin="6,0,0,0" Command="{Binding GeneratePasswordCommand}" />
                <Button Grid.Column="2" Content="Reset" Margin="6,0,0,0" Command="{Binding ResetPasswordCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Permissions: one row per module -->
          <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowPermissions, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Permissions" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="Tick Access to let the user open a module; Access alone means view only."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />

            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox ItemsSource="{Binding UserOptions}" DisplayMemberPath="Name" SelectedItem="{Binding CopyFromUser}" />
              <Button Grid.Column="1" Content="Copy from this user" Margin="6,0,0,0" Command="{Binding CopyPermissionsCommand}"
                      ToolTip="Fill the grid with another user's permissions (press Save to keep them)" />
            </Grid>

            <ItemsControl ItemsSource="{Binding PermissionGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,10,0,0">
                    <Grid Background="#E9EDF3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" Margin="8,4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="All" Padding="8,1" MinWidth="0" Margin="10,0,0,0" Command="{Binding SelectAllCommand}"
                                ToolTip="Give access to every module in this group" />
                        <Button Content="None" Padding="8,1" MinWidth="0" Margin="4,0,0,0" Command="{Binding ClearAllCommand}"
                                ToolTip="Remove access to every module in this group" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="Access" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                      <TextBlock Grid.Column="2" Text="Create" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                      <TextBlock Grid.Column="3" Text="Edit" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                      <TextBlock Grid.Column="4" Text="Delete" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                      <TextBlock Grid.Column="5" Text="Print" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Background="White" Height="28">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="52" />
                              <ColumnDefinition Width="52" />
                              <ColumnDefinition Width="52" />
                              <ColumnDefinition Width="52" />
                              <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ModuleName}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding HasAccess}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="2" IsChecked="{Binding AllowCreate}" IsEnabled="{Binding SupportsCreate}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="3" IsChecked="{Binding AllowEdit}" IsEnabled="{Binding SupportsEdit}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="4" IsChecked="{Binding AllowDelete}" IsEnabled="{Binding SupportsDelete}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="5" IsChecked="{Binding AllowPrint}" IsEnabled="{Binding SupportsPrint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>
</ResourceDictionary>
