          <Button Content="Print" Margin="8,0,0,0" Command="{Binding PrintCommand}"
                  ToolTip="Save, then open the print preview" />
          <Button Content="Reset to defaults" Margin="8,0,0,0" Command="{Binding ResetToDefaultsCommand}"
                  Visibility="{Binding CanResetToDefaults, Converter={StaticResource BoolToVis}}"
                  ToolTip="Put the saved defaults back into the result fields" />
          <Button Content="Defaults" Margin="8,0,0,0" Command="{Binding EnterDefaultsCommand}"
                  Visibility="{Binding ShowDefaultsButton, Converter={StaticResource BoolToVis}}"
                  ToolTip="Set the values every new result starts with (administrators)" />
        </StackPanel>
      </ctl:CrudLayout.FooterContent>

      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <ctl:LabResultTop />

          <!-- The rest of the person box -->
          <Grid Margin="0,-10,0,10" IsEnabled="{Binding IsNotSettingDefaults}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Contact No.:" Style="{StaticResource PaperLabel}" />
            <TextBox Grid.Column="1" Margin="0,2,14,2" Text="{Binding ContactNo, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Text="Civil Status:" Style="{StaticResource PaperLabel}" />
            <ComboBox Grid.Column="3" Margin="0,2" IsEditable="True" ItemsSource="{Binding CivilStatuses}" Text="{Binding CivilStatus, UpdateSourceTrigger=LostFocus}" />
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.35*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- V. Laboratory / X-ray results -->
            <StackPanel Grid.Column="0">
              <TextBlock Text="V. LABORATORY / X-RAY RESULTS" Style="{StaticResource PaperLabel}" FontWeight="SemiBold" Margin="0,0,0,3" />
              <Border BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="1,1,0,0" Background="White">
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="150" />
                          <ColumnDefinition Width="122" />
                          <ColumnDefinition Width="122" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="6,5">
                          <TextBlock Text="{Binding Label}" Style="{StaticResource PaperLabel}" TextWrapping="Wrap" />
                        </Border>
                        <Border Grid.Column="1" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="8,4">
                          <CheckBox Content="{Binding NormalCaption}" IsChecked="{Binding Normal.IsChecked}" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="2" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="8,4">
                          <CheckBox Content="{Binding FindingsCaption}" IsChecked="{Binding Findings.IsChecked}" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="3" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="4,3">
                          <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" ToolTip="A note for this result" />
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>

            <!-- VI. Classification -->
            <StackPanel Grid.Column="2">
              <TextBlock Text="VI. CLASSIFICATION" Style="{StaticResource PaperLabel}" FontWeight="SemiBold" Margin="0,0,0,3" />
              <Border BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="1" Background="White" Padding="8,6">
                <StackPanel>
                  <CheckBox Margin="0,4" VerticalContentAlignment="Top" IsChecked="{Binding Classification[Fit].IsChecked}">
                    <TextBlock Text="A - Fit for employment." TextWrapping="Wrap" />
                  </CheckBox>
                  <CheckBox Margin="0,4" VerticalContentAlignment="Top" IsChecked="{Binding Classification[Fit2].IsChecked}">
                    <TextBlock Text="B - Fit for employment; with minor ailment/defect." TextWrapping="Wrap" />
                  </CheckBox>
                  <CheckBox Margin="0,4" VerticalContentAlignment="Top" IsChecked="{Binding Classification[Acceptable].IsChecked}">
                    <TextBlock Text="C - Acceptable employment; defect may not be easily corrected." TextWrapping="Wrap" />
                  </CheckBox>
                  <CheckBox Margin="0,4" VerticalContentAlignment="Top" IsChecked="{Binding Classification[Unfit].IsChecked}">
                    <TextBlock Text="D - Unfit for employment." TextWrapping="Wrap" />
                  </CheckBox>
                  <CheckBox Margin="0,4" VerticalContentAlignment="Top" IsChecked="{Binding Classification[Pending].IsChecked}">
                    <TextBlock Text="PENDING - Incomplete medical laboratory exam." TextWrapping="Wrap" />
                  </CheckBox>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <TextBlock Text="Medical/Surgical History:" Style="{StaticResource PaperLabel}" Margin="0,10,0,2" />
          <ctl:TemplateTextBox Text="{Binding MedicalSurgicalHistory, UpdateSourceTrigger=PropertyChanged}" Options="{Binding HistoryTemplates}" EditCommand="{Binding EditHistoryTemplatesCommand}" MinHeight="84" MaxHeight="150" />

          <TextBlock Text="Assessment:" Style="{StaticResource PaperLabel}" Margin="0,8,0,2" />
          <ctl:TemplateTextBox Text="{Binding Assessment, UpdateSourceTrigger=PropertyChanged}" Options="{Binding AssessmentTemplates}" EditCommand="{Binding EditAssessmentTemplatesCommand}" MinHeight="120" MaxHeight="200" />

          <TextBlock Text="Remarks:" Style="{StaticResource PaperLabel}" Margin="0,8,0,2" />
          <ctl:TemplateTextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" Options="{Binding RemarksTemplates}" EditCommand="{Binding EditRemarksTemplatesCommand}" MinHeight="84" MaxHeight="150" />

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Assessment Done By" Style="{StaticResource PaperLabel}" Margin="0,0,0,3" />
              <ctl:ChoiceBox ItemsSource="{Binding AssessmentDoneBy.Items}" Text="{Binding AssessmentDoneBy.Value}" EditCommand="{Binding AssessmentDoneBy.EditCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Physician Name" Style="{StaticResource PaperLabel}" Margin="0,0,0,3" />
              <ctl:ChoiceBox ItemsSource="{Binding PhysicianName.Items}" Text="{Binding PhysicianName.Value}" EditCommand="{Binding PhysicianName.EditCommand}" />
              <TextBlock Text="Physician License" Style="{StaticResource PaperLabel}" Margin="0,6,0,3" />
              <ctl:ChoiceBox ItemsSource="{Binding PhysicianLicense.Items}" Text="{Binding PhysicianLicense.Value}" EditCommand="{Binding PhysicianLicense.EditCommand}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>
  <!-- ===================================================== Hematology -->
  <DataTemplate x:Key="NormalResultForm">
    <ctl:CrudLayout FormMaxWidth="940">
      <ctl:CrudLayout.SearchFilters>
        <DockPanel Margin="0,0,0,8" LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="Clear filters" Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}" />
          <DatePicker SelectedDate="{Binding DateFilter}" ToolTip="Only show results of one day" />
        </DockPanel>
      </ctl:CrudLayout.SearchFilters>

      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd MMM yy'}" Width="75" />
            <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*" />
            <DataGridTextColumn Header="Registration" Binding="{Binding RegistrationCode}" Width="138" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>

      <ctl:CrudLayout.FooterContent>
        <StackPanel Orientation="Horizontal">
          <Button Content="Save &amp; New" Command="{Binding SaveAndNewCommand}" IsEnabled="{Binding CanSave}"
                  ToolTip="Save, then start the next result (Ctrl+S saves)" />
          <Button Content="Print" Margin="8,0,0,0" Command="{Binding PrintCommand}"
                  ToolTip="Save, then open the print preview" />
          <Button Content="Reset to defaults" Margin="8,0,0,0" Command="{Binding ResetToDefaultsCommand}"
                  Visibility="{Binding CanResetToDefaults, Converter={StaticResource BoolToVis}}"
                  ToolTip="Put the saved defaults back into the result fields" />
          <Button Content="Defaults" Margin="8,0,0,0" Command="{Binding EnterDefaultsCommand}"
                  Visibility="{Binding ShowDefaultsButton, Converter={StaticResource BoolToVis}}"
                  ToolTip="Set the values every new result starts with, such as the normal values (administrators)" />
        </StackPanel>
      </ctl:CrudLayout.FooterContent>

      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <ctl:LabResultTop />

          <!-- The table of the paper form: test, normal values (what a new form starts with), result -->
          <Border Margin="0,6,0,0" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="1,1,0,0" Background="White">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="240" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="6,4">
                  <TextBlock Text="{Binding TableTitle}" Style="{StaticResource PaperLabel}" FontWeight="SemiBold" />
                </Border>
                <Border Grid.Column="1" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="6,4">
                  <TextBlock Text="Normal Values" Style="{StaticResource PaperLabel}" FontWeight="SemiBold" />
                </Border>
                <Border Grid.Column="2" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="6,4">
                  <TextBlock Text="Result" Style="{StaticResource PaperLabel}" FontWeight="SemiBold" />
                </Border>
              </Grid>
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="6,3">
                        <TextBlock Text="{Binding Label}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PaperLabel}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Indented}" Value="True">
                                  <Setter Property="Margin" Value="22,0,6,0" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                      <Border Grid.Column="1" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="4,2">
                        <TextBox Text="{Binding NormalValue, UpdateSourceTrigger=PropertyChanged}" />
                      </Border>
                      <Border Grid.Column="2" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="4,2">
                        <TextBox Text="{Binding Result, UpdateSourceTrigger=PropertyChanged}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <ctl:LabResultBottom ShowRemarks="{Binding ShowRemarks}" />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:HematologyViewModel}">
    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NormalResultForm}" />
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:ClinicalChemistryViewModel}">
    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NormalResultForm}" />
  </DataTemplate>
  <!-- ===================================================== Annual Physical Exam -->
  <DataTemplate DataType="{x:Type vm:AnnualPhysicalExamViewModel}">
    <DataTemplate.Resources>
      <!-- The labels of the tick boxes are as muted as the other labels of the form -->
      <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      </Style>
      <!-- Tick boxes of an exclusive group (Yes/No, Daily/Weekly/Occasional) side by side -->
      <DataTemplate x:Key="OptionTick">
        <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked}" Margin="0,0,14,0" VerticalAlignment="Center" />
      </DataTemplate>
      <ItemsPanelTemplate x:Key="HorizontalPanel">
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
      <!-- One table row of the physical examination: label, N, F -->
      <DataTemplate x:Key="ExamRow">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="28" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="6,3">
            <TextBlock Text="{Binding Label}" Style="{StaticResource PaperLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
          </Border>
          <Border Grid.Column="1" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1">
            <CheckBox IsChecked="{Binding Normal.IsChecked}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Normal or none" />
          </Border>
          <Border Grid.Column="2" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1">
            <CheckBox IsChecked="{Binding Findings.IsChecked}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="With findings (describe them under Findings)" />
          </Border>
        </Grid>
      </DataTemplate>
    </DataTemplate.Resources>
    <ctl:CrudLayout FormMaxWidth="940">
      <ctl:CrudLayout.SearchFilters>
        <DockPanel Margin="0,0,0,8" LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="Clear filters" Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}" />
          <DatePicker SelectedDate="{Binding DateFilter}" ToolTip="Only show results of one day" />
        </DockPanel>
      </ctl:CrudLayout.SearchFilters>

      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd MMM yy'}" Width="75" />
            <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*" />
            <DataGridTextColumn Header="Registration" Binding="{Binding RegistrationCode}" Width="138" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>

      <ctl:CrudLayout.FooterContent>
        <StackPanel Orientation="Horizontal">
          <Button Content="Save &amp; New" Command="{Binding SaveAndNewCommand}" IsEnabled="{Binding CanSave}"
                  ToolTip="Save, then start the next result (Ctrl+S saves)" />
          <Button Content="Print" Margin="8,0,0,0" Command="{Binding PrintCommand}"
                  ToolTip="Save, then open the print preview" />
          <Button Content="Reset to defaults" Margin="8,0,0,0" Command="{Binding ResetToDefaultsCommand}"
                  Visibility="{Binding CanResetToDefaults, Converter={StaticResource BoolToVis}}"
                  ToolTip="Put the saved defaults back into the result fields" />
          <Button Content="Defaults" Margin="8,0,0,0" Command="{Binding EnterDefaultsCommand}"
                  Visibility="{Binding ShowDefaultsButton, Converter={StaticResource BoolToVis}}"
                  ToolTip="Set the values every new result starts with (administrators)" />
        </StackPanel>
      </ctl:CrudLayout.FooterContent>

      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <ctl:LabResultTop />

          <!-- The rest of the person box -->
          <Grid Margin="0,-10,0,10" IsEnabled="{Binding IsNotSettingDefaults}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="175" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Department/Agency:" Style="{StaticResource PaperLabel}" />
            <TextBox Grid.Column="1" Margin="0,2,14,2" Text="{Binding DepartmentOrAgency, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Text="Birth Date:" Style="{StaticResource PaperLabel}" />
            <DatePicker Grid.Column="3" Margin="0,2,14,2" SelectedDate="{Binding BirthDate}" />
            <TextBlock Grid.Column="4" Text="Civil Status:" Style="{StaticResource PaperLabel}" />
            <ComboBox Grid.Column="5" Margin="0,2,14,2" IsEditable="True" ItemsSource="{Binding CivilStatuses}" Text="{Binding CivilStatus, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Grid.Column="6" Text="Contact No.:" Style="{StaticResource PaperLabel}" />
            <TextBox Grid.Column="7" Margin="0,2" Text="{Binding ContactNo, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>

          <!-- ================= Past medical history -->
          <TextBlock Text="PAST MEDICAL HISTORY" Style="{StaticResource PaperLabel}" FontWeight="SemiBold" Margin="0,0,0,3" />
          <Border BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="1,1,0,0" Background="White">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding HistoryRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="6,3">
                        <TextBlock Text="{Binding Left.Label}" Style="{StaticResource PaperLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Left.Label}" />
                      </Border>
                      <Border Grid.Column="1" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="4,2">
                        <ctl:ChoiceBox ItemsSource="{Binding Left.Items}" Text="{Binding Left.Value}" EditCommand="{Binding Left.EditCommand}" />
                      </Border>
                      <Border Grid.Column="2" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="6,3">
                        <TextBlock Text="{Binding Right.Label}" Style="{StaticResource PaperLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Right.Label}" />
                      </Border>
                      <Border Grid.Column="3" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="4,2">
                        <ctl:ChoiceBox ItemsSource="{Binding Right.Items}" Text="{Binding Right.Value}" EditCommand="{Binding Right.EditCommand}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Others -->
              <Border BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="6,4">
                <DockPanel>
                  <TextBlock Text="Others:" Style="{StaticResource PaperLabel}" />
                  <ctl:TemplateTextBox Margin="8,0,0,0" Text="{Binding OthersPast, UpdateSourceTrigger=PropertyChanged}" Options="{Binding OthersPastTemplates}" EditCommand="{Binding EditOthersPastTemplatesCommand}" MinHeight="26" MaxHeight="70" />
                </DockPanel>
              </Border>

              <!-- Medications | Allergies -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="6,4">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Medications:" Style="{StaticResource PaperLabel}" Margin="0,0,0,2" />
                    <ctl:TemplateTextBox Text="{Binding Medications, UpdateSourceTrigger=PropertyChanged}" Options="{Binding MedicationsTemplates}" EditCommand="{Binding EditMedicationsTemplatesCommand}" MinHeight="40" MaxHeight="70" />
                  </DockPanel>
                </Border>
                <Border Grid.Column="1" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="6,4">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Allergies:" Style="{StaticResource PaperLabel}" Margin="0,0,0,2" />
                    <ctl:TemplateTextBox Text="{Binding Allergies, UpdateSourceTrigger=PropertyChanged}" Options="{Binding AllergiesTemplates}" EditCommand="{Binding EditAllergiesTemplatesCommand}" MinHeight="40" MaxHeight="70" />
                  </DockPanel>
                </Border>
              </Grid>

              <!-- Review of systems -->
              <Border BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="6,4">
                <DockPanel>
                  <TextBlock Text="Review of Systems:" Style="{StaticResource PaperLabel}" />
                  <ctl:TemplateTextBox Margin="8,0,0,0" Text="{Binding ReviewOfSystems, UpdateSourceTrigger=PropertyChanged}" Options="{Binding ReviewOfSystemsTemplates}" EditCommand="{Binding EditReviewOfSystemsTemplatesCommand}" MinHeight="26" MaxHeight="70" />
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- ================= Present medical history -->
          <TextBlock Text="PRESENT MEDICAL HISTORY" Style="{StaticResource PaperLabel}" FontWeight="SemiBold" Margin="0,10,0,3" />
          <Border BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="1" Background="White">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Smoking:" Style="{StaticResource PaperLabel}" Margin="6,6,0,6" />
              <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Smoking.Options}" ItemTemplate="{StaticResource OptionTick}" ItemsPanel="{StaticResource HorizontalPanel}" VerticalAlignment="Center" />
              <TextBlock Grid.Row="0" Grid.Column="2" Text="Since when:" Style="{StaticResource PaperLabel}" Margin="10,0,6,0" />
              <TextBox Grid.Row="0" Grid.Column="3" Margin="0,3" Text="{Binding SmokingSinceWhen, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Row="0" Grid.Column="4" Text="# of Sticks per day:" Style="{StaticResource PaperLabel}" Margin="14,0,6,0" />
              <TextBox Grid.Row="0" Grid.Column="5" Margin="0,3" Text="{Binding SticksPerDay, UpdateSourceTrigger=PropertyChanged}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Drinking (Alcoholic):" Style="{StaticResource PaperLabel}" Margin="6,6,0,6" />
              <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Drinking.Options}" ItemTemplate="{StaticResource OptionTick}" ItemsPanel="{StaticResource HorizontalPanel}" VerticalAlignment="Center" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="Since when:" Style="{StaticResource PaperLabel}" Margin="10,0,6,0" />
              <TextBox Grid.Row="1" Grid.Column="3" Margin="0,3" Text="{Binding DrinkingSinceWhen, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Row="1" Grid.Column="4" Text="# of Bottles:" Style="{StaticResource PaperLabel}" Margin="14,0,6,0" />
              <TextBox Grid.Row="1" Grid.Column="5" Margin="0,3" Text="{Binding Bottles, UpdateSourceTrigger=PropertyChanged}" />
              <ItemsControl Grid.Row="1" Grid.Column="6" Margin="14,0,0,0" ItemsSource="{Binding DrinkingFrequency.Options}" ItemTemplate="{StaticResource OptionTick}" ItemsPanel="{StaticResource HorizontalPanel}" VerticalAlignment="Center" />

              <StackPanel Grid.Row="2" Grid.ColumnSpan="7" Orientation="Horizontal" Margin="6,3,6,3">
                <TextBlock Text="LMP (First day of last menstrual period):" Style="{StaticResource PaperLabel}" />
                <TextBox Width="140" Margin="8,0,16,0" Text="{Binding Lmp, UpdateSourceTrigger=PropertyChanged}" />
                <ItemsControl ItemsSource="{Binding LmpType.Options}" ItemTemplate="{StaticResource OptionTick}" ItemsPanel="{StaticResource HorizontalPanel}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- ================= Vital signs, BMI category and visual acuity -->
          <TextBlock Text="VITAL SIGNS AND VISUAL ACUITY" Style="{StaticResource PaperLabel}" FontWeight="SemiBold" Margin="0,10,0,3" />
          <Border BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="1" Background="White" Padding="8,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Vital signs -->
              <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="76" />
                  <ColumnDefinition Width="76" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="1st" Style="{StaticResource PaperLabel}" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="2nd" Style="{StaticResource PaperLabel}" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="BP Reading (mm/Hg):" Style="{StaticResource PaperLabel}" Margin="0,0,8,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,3,2" Text="{Binding Bp1st, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="1" Grid.Column="2" Margin="3,2,0,2" Text="{Binding Bp2nd, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Cardiac Rate (bpm):" Style="{StaticResource PaperLabel}" Margin="0,0,8,0" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2,3,2" Text="{Binding CardiacRate1st, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="2" Grid.Column="2" Margin="3,2,0,2" Text="{Binding CardiacRate2nd, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Grid.Column="4" Text="Height (feet):" Style="{StaticResource PaperLabel}" Margin="0,0,8,0" />
                <TextBox Grid.Row="1" Grid.Column="5" Margin="0,2" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Grid.Column="4" Text="Weight (Kg):" Style="{StaticResource PaperLabel}" Margin="0,0,8,0" />
                <TextBox Grid.Row="2" Grid.Column="5" Margin="0,2" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>

              <!-- BMI category: a tall box between the vital signs and the visual acuity, as on paper -->
              <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="BMI Category:" Style="{StaticResource PaperLabel}" Margin="0,0,0,2" />
                <ctl:TemplateTextBox Text="{Binding BmiCategory, UpdateSourceTrigger=PropertyChanged}" Options="{Binding BmiCategoryTemplates}" EditCommand="{Binding EditBmiCategoryTemplatesCommand}" PickerOnTop="True" MinHeight="60" />
              </DockPanel>

              <!-- Visual acuity -->
              <Grid Grid.Column="4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" MinWidth="56" />
                  <ColumnDefinition Width="*" MinWidth="56" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Right Eye" Style="{StaticResource PaperLabel}" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Left Eye" Style="{StaticResource PaperLabel}" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Far w/ eyeglasses:" Style="{StaticResource PaperLabel}" Margin="0,0,8,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,3,2" Text="{Binding VaRightWith, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="1" Grid.Column="2" Margin="3,2,0,2" Text="{Binding VaLeftWith, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Far w/o eyeglasses:" Style="{StaticResource PaperLabel}" Margin="0,0,8,0" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2,3,2" Text="{Binding VaRightWithout, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Row="2" Grid.Column="2" Margin="3,2,0,2" Text="{Binding VaLeftWithout, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="4" VerticalAlignment="Center">
                  <CheckBox Content="Normal" Margin="0,2" IsChecked="{Binding VisualAcuity[Normal].IsChecked}" />
                  <CheckBox Content="EOR" Margin="0,2" IsChecked="{Binding VisualAcuity[EOR].IsChecked}" />
                  <CheckBox Margin="0,2" VerticalContentAlignment="Top" IsChecked="{Binding VisualAcuity[Corrected].IsChecked}">
                    <TextBlock Text="Corrected with eyeglasses / contact lenses" TextWrapping="Wrap" MaxWidth="100" />
                  </CheckBox>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <!-- ================= Physical examination -->
          <DockPanel Margin="0,10,0,3">
            <TextBlock DockPanel.Dock="Right" Text="N - Normal or None; F - With Findings, if with Findings, describe" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="PHYSICAL EXAMINATION" Style="{StaticResource PaperLabel}" FontWeight="SemiBold" />
          </DockPanel>
          <Border BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="1,1,0,0" Background="White">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ItemsControl Grid.Column="0" ItemsSource="{Binding ExamColumn1}" ItemTemplate="{StaticResource ExamRow}" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding ExamColumn2}" ItemTemplate="{StaticResource ExamRow}" />
              <ItemsControl Grid.Column="2" ItemsSource="{Binding ExamColumn3}" ItemTemplate="{StaticResource ExamRow}" />
            </Grid>
          </Border>

          <!-- ================= Findings and who took the measurements -->
          <TextBlock Text="Findings:" Style="{StaticResource PaperLabel}" Margin="0,10,0,2" />
          <ctl:TemplateTextBox Text="{Binding Findings, UpdateSourceTrigger=PropertyChanged}" Options="{Binding FindingsTemplates}" EditCommand="{Binding EditFindingsTemplatesCommand}" MinHeight="46" MaxHeight="90" />

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Vital Signs Done By" Style="{StaticResource PaperLabel}" Margin="0,0,0,3" />
              <ctl:ChoiceBox ItemsSource="{Binding VitalSignsBy.Items}" Text="{Binding VitalSignsBy.Value}" EditCommand="{Binding VitalSignsBy.EditCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Height and Weight Done By" Style="{StaticResource PaperLabel}" Margin="0,0,0,3" />
              <ctl:ChoiceBox ItemsSource="{Binding HeightWeightBy.Items}" Text="{Binding HeightWeightBy.Value}" EditCommand="{Binding HeightWeightBy.EditCommand}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Companies -->
  <DataTemplate DataType="{x:Type vm:CompaniesViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding CompanyName}" Width="*" />
            <DataGridTextColumn Header="Contact person" Binding="{Binding ContactPerson}" Width="150" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Address" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />

          <TextBlock Text="Contact numbers" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ContactNumbers, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Contact person" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Departments -->
  <DataTemplate DataType="{x:Type vm:DepartmentsViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding DepartmentName}" Width="180" />
            <DataGridTextColumn Header="Description" Binding="{Binding DepartmentDescription}" Width="*" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding DepartmentName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding DepartmentDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Item locations -->
  <DataTemplate DataType="{x:Type vm:ItemLocationsViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding ItemLocationName}" Width="*" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ItemLocationName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Services -->
  <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding ServiceName}" Width="140" />
            <DataGridTextColumn Header="Description" Binding="{Binding ServiceDescription}" Width="*" />
            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="90">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextAlignment" Value="Right" />
                  <Setter Property="Margin" Value="0,0,6,0" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ServiceDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />
          <TextBlock Text="Price" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Price, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Items (with stock per location) -->
  <DataTemplate DataType="{x:Type vm:ItemsViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding ItemName}" Width="*" />
            <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat=N2}" Width="85" />
            <DataGridTextColumn Header="In stock" Binding="{Binding TotalQuantity, StringFormat=N2}" Width="85" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Cost" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Cost, StringFormat=N2, UpdateSourceTrigger=LostFocus}" />

          <TextBlock Text="Quantities by location" Style="{StaticResource FieldLabel}" Margin="0,16,0,3" />
          <DataGrid ItemsSource="{Binding Quantities}" SelectedItem="{Binding SelectedQuantity}" IsReadOnly="False"
                    Height="170" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Location" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding DataContext.Locations, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                              SelectedValuePath="Id" DisplayMemberPath="Name"
                              SelectedValue="{Binding ItemLocationId, UpdateSourceTrigger=PropertyChanged}"
                              BorderThickness="0" Background="Transparent" Padding="4,2" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Width="90" />
            </DataGrid.Columns>
          </DataGrid>
          <DockPanel Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="+" MinWidth="36" Command="{Binding AddQuantityCommand}" ToolTip="Add a location" />
            <Button DockPanel.Dock="Left" Content="-" MinWidth="36" Margin="6,0,0,0" Command="{Binding RemoveQuantityCommand}" ToolTip="Remove the selected row" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
              <Run Text="Total: " Foreground="{StaticResource MutedTextBrush}" /><Run Text="{Binding TotalQuantity, Mode=OneWay, StringFormat=N2}" FontWeight="SemiBold" />
            </TextBlock>
          </DockPanel>
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Discounts (options: amount or percentage) -->
  <DataTemplate DataType="{x:Type vm:DiscountsViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding DiscountName}" Width="170" />
            <DataGridTextColumn Header="Description" Binding="{Binding DiscountDescription}" Width="*" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding DiscountName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding DiscountDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />

          <DockPanel Margin="0,16,0,3">
            <Button DockPanel.Dock="Right" Content="+ Add option" Command="{Binding AddLineCommand}"
                    ToolTip="Add another amount or percentage this discount can be given as" />
            <TextBlock Text="Options (each one is an amount or a percentage)" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
          </DockPanel>
          <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Background="White" MinHeight="60">
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="8,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" Content="Amount" VerticalAlignment="Center" Margin="0,0,14,0"
                                 IsChecked="{Binding IsPercentage, Converter={StaticResource InverseBool}}" />
                    <RadioButton Grid.Column="1" Content="Percentage" VerticalAlignment="Center" Margin="0,0,14,0"
                                 IsChecked="{Binding IsPercentage}" />
                    <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                             HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Content="&#x2715;" MinWidth="0" MinHeight="0" Width="24" Height="22" Padding="0" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0,0,0" ToolTip="Remove this option"
                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <TextBlock Text="No options yet. Press + Add option." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Lines.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Packages -->
  <DataTemplate DataType="{x:Type vm:PackagesViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding PackageName}" Width="*" />
            <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="130" />
            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="85" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding PackageName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding PackageDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                   TextWrapping="Wrap" MinHeight="50" VerticalScrollBarVisibility="Auto" />

          <TextBlock Text="Company" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding Companies}" SelectedValuePath="Id" DisplayMemberPath="Name"
                    SelectedValue="{Binding CompanyChoiceId}" />

          <TextBlock Text="Package price" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Price, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                   ToolTip="Follows the total of the included services until you type a price" />

          <DockPanel Margin="0,16,0,4">
            <Button DockPanel.Dock="Right" Content="+ Add services" Command="{Binding ChooseServicesCommand}"
                    ToolTip="Open the list of services; tick the ones in this package" />
            <TextBlock Text="Included services" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
          </DockPanel>
          <DataGrid ItemsSource="{Binding Services}" IsReadOnly="False" Height="190" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" IsReadOnly="True" Width="*" />
              <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2, UpdateSourceTrigger=LostFocus}" Width="90" />
              <DataGridTemplateColumn Width="42">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="&#x2715;" MinWidth="0" MinHeight="0" Width="24" Height="22" Padding="0" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="Remove this service"
                            Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="No services yet. Press + Add services." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Services.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>

  <!-- ===================================================== Users (with the permission grid) -->
  <DataTemplate DataType="{x:Type vm:UsersViewModel}">
    <ctl:CrudLayout>
      <ctl:CrudLayout.GridContent>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="User name" Binding="{Binding Username}" Width="110" />
            <DataGridTextColumn Header="Full name" Binding="{Binding FullName}" Width="*" />
            <DataGridCheckBoxColumn Header="Admin" Binding="{Binding IsAdmin}" Width="55" />
            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
            <DataGridCheckBoxColumn Header="Locked" Binding="{Binding IsLocked}" Width="55" />
          </DataGrid.Columns>
        </DataGrid>
      </ctl:CrudLayout.GridContent>
      <ctl:CrudLayout.FormContent>
        <StackPanel>
          <TextBlock Text="User name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Full name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

          <CheckBox Content="Administrator (can open everything, including Management and Settings)"
                    IsChecked="{Binding IsAdmin}" Margin="0,14,0,0" />

          <!-- New user: the first, temporary password -->
          <StackPanel Visibility="{Binding CanSetTemporaryPassword, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Temporary password" Style="{StaticResource FieldLabel}" Margin="0,14,0,3" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding TemporaryPassword, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
              <Button Grid.Column="1" Content="Generate" Margin="6,0,0,0" Command="{Binding GeneratePasswordCommand}" />
            </Grid>
            <TextBlock Text="The user must choose their own password the first time they sign in."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>

          <!-- Existing user: status, unlock and password reset -->
          <Border Margin="0,16,0,0" Padding="12,8,12,12" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                  CornerRadius="3" Background="White"
                  Visibility="{Binding CanManageExisting, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Text="Account" FontWeight="SemiBold" />
              <TextBlock Text="{Binding AccountStatus}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
              <Button Content="Unlock account" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding UnlockCommand}"
                      Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />

              <TextBlock Text="Reset password" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding TemporaryPassword, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                <Button Grid.Column="1" Content="Generate" Margin="6,0,0,0" Command="{Binding GeneratePasswordCommand}" />
                <Button Grid.Column="2" Content="Reset" Margin="6,0,0,0" Command="{Binding ResetPasswordCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Permissions: one row per module -->
          <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowPermissions, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Permissions" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="Tick Access to let the user open a module; Access alone means view only."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />

            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox ItemsSource="{Binding UserOptions}" DisplayMemberPath="Name" SelectedItem="{Binding CopyFromUser}" />
              <Button Grid.Column="1" Content="Copy from this user" Margin="6,0,0,0" Command="{Binding CopyPermissionsCommand}"
                      ToolTip="Fill the grid with another user's permissions (press Save to keep them)" />
            </Grid>

            <ItemsControl ItemsSource="{Binding PermissionGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,10,0,0">
                    <Grid Background="#E9EDF3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" Margin="8,4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="All" Padding="8,1" MinWidth="0" Margin="10,0,0,0" Command="{Binding SelectAllCommand}"
                                ToolTip="Give access to every module in this group" />
                        <Button Content="None" Padding="8,1" MinWidth="0" Margin="4,0,0,0" Command="{Binding ClearAllCommand}"
                                ToolTip="Remove access to every module in this group" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="Access" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                      <TextBlock Grid.Column="2" Text="Create" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                      <TextBlock Grid.Column="3" Text="Edit" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                      <TextBlock Grid.Column="4" Text="Delete" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                      <TextBlock Grid.Column="5" Text="Print" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Background="White" Height="28">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="52" />
                              <ColumnDefinition Width="52" />
                              <ColumnDefinition Width="52" />
                              <ColumnDefinition Width="52" />
                              <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ModuleName}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding HasAccess}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="2" IsChecked="{Binding AllowCreate}" IsEnabled="{Binding SupportsCreate}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="3" IsChecked="{Binding AllowEdit}" IsEnabled="{Binding SupportsEdit}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="4" IsChecked="{Binding AllowDelete}" IsEnabled="{Binding SupportsDelete}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="5" IsChecked="{Binding AllowPrint}" IsEnabled="{Binding SupportsPrint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
  </DataTemplate>
</ResourceDictionary>
