          <!-- The result table of the paper form: two columns of label and value, then the Others box -->
          <Border Margin="0,6,0,0" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="1" Background="White">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="6,3">
                        <TextBlock Text="{Binding Left.Label, StringFormat='{}{0}:'}" Style="{StaticResource PaperLabel}" />
                      </Border>
                      <Border Grid.Column="1" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="4,2">
                        <ctl:ChoiceBox ItemsSource="{Binding Left.Items}" Text="{Binding Left.Value}" EditCommand="{Binding Left.EditCommand}" />
                      </Border>
                      <Border Grid.Column="2" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,1,1" Padding="6,3">
                        <TextBlock Text="{Binding Right.Label, StringFormat='{}{0}:'}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PaperLabel}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Right}" Value="{x:Null}">
                                  <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                      <Border Grid.Column="3" BorderBrush="{StaticResource PaperLineBrush}" BorderThickness="0,0,0,1" Padding="4,2">
                        <ctl:ChoiceBox ItemsSource="{Binding Right.Items}" Text="{Binding Right.Value}" EditCommand="{Binding Right.EditCommand}">
                          <ctl:ChoiceBox.Style>
                            <Style TargetType="ctl:ChoiceBox">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Right}" Value="{x:Null}">
                                  <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ctl:ChoiceBox.Style>
                        </ctl:ChoiceBox>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <DockPanel Margin="6,4,6,6">
                <TextBlock DockPanel.Dock="Top" Text="Others:" Style="{StaticResource PaperLabel}" Margin="0,0,0,2" />
                <ctl:TemplateTextBox Text="{Binding Others, UpdateSourceTrigger=PropertyChanged}" Options="{Binding OthersTemplates}" EditCommand="{Binding EditOthersTemplatesCommand}" MinHeight="46" MaxHeight="90" />
              </DockPanel>
            </StackPanel>
          </Border>

          <ctl:LabResultBottom />
        </StackPanel>
      </ctl:CrudLayout.FormContent>
    </ctl:CrudLayout>
