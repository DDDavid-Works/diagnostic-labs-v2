<UserControl x:Class="DiagnosticLabs.Wpf.Views.BatchPrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icn="clr-namespace:DiagnosticLabs.Wpf.Controls"
             Loaded="OnLoaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Yes (green) or No (red): has the result been inputted -->
    <Style x:Key="ResultCell" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasResult}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="24,16,24,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Batch Print" Style="{StaticResource PageTitle}" Margin="0,0,0,12" />

    <!-- Parameters -->
    <StackPanel Grid.Row="1" HorizontalAlignment="Left" Width="620">
      <Border Background="White" Padding="20,16" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Text="Parameters" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Company *" Style="{StaticResource PaperLabel}" VerticalAlignment="Center" />
          <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" ItemsSource="{Binding Companies}" DisplayMemberPath="Name"
                    SelectedValuePath="Id" SelectedValue="{Binding CompanyId}" Margin="0,0,0,10" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Batch" Style="{StaticResource PaperLabel}" VerticalAlignment="Center" />
          <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" ItemsSource="{Binding Batches}" SelectedItem="{Binding Batch}" Margin="0,0,0,10"
                    IsEnabled="{Binding CanPickBatch}" ToolTip="Pick a company to choose one of its batches" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Result Date" Style="{StaticResource PaperLabel}" VerticalAlignment="Center" />
          <DatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding DateFrom}" Margin="0,0,0,10" ToolTip="Optional: only results made from this day" />
          <TextBlock Grid.Row="3" Grid.Column="2" Text="to" Style="{StaticResource PaperLabel}" Margin="10,0,10,10" VerticalAlignment="Center" />
          <DatePicker Grid.Row="3" Grid.Column="3" SelectedDate="{Binding DateTo}" Margin="0,0,0,10" ToolTip="Optional: only results made up to this day" />
          <Button Grid.Row="3" Grid.Column="4" Content="Clear" Margin="10,0,0,10" Padding="10,4" MinWidth="0" Command="{Binding ClearDatesCommand}"
                  ToolTip="Remove the date range: every result" />

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Service *" Style="{StaticResource PaperLabel}" VerticalAlignment="Center" />
          <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" ItemsSource="{Binding Services}" DisplayMemberPath="Name"
                    SelectedValuePath="ServiceId" SelectedValue="{Binding ServiceId}" ToolTip="The result form to print" />
        </Grid>
      </Border>

      <DockPanel Margin="0,10,0,0">
        <Button DockPanel.Dock="Right" icn:ButtonIcon.Data="{StaticResource Icon.Search}" Content="Search" Padding="14,6" Command="{Binding SearchCommand}"
                ToolTip="List the patients of the batch and whether their results are inputted" />
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource DangerBrush}" />
      </DockPanel>
    </StackPanel>

    <!-- The patients found: is the result inputted, and when -->
    <Grid Grid.Row="2" HorizontalAlignment="Left" Width="620" Margin="0,14,0,0" Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
      <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" IsReadOnly="True" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Patient Name" Binding="{Binding PatientName}" Width="*" />
          <DataGridTextColumn Header="Results Inputted" Binding="{Binding ResultText}" Width="140" ElementStyle="{StaticResource ResultCell}" />
          <DataGridTextColumn Header="Date Inputted" Binding="{Binding DateText}" Width="150" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <Button Grid.Row="3" icn:ButtonIcon.Data="{StaticResource Icon.Print}" Content="Print" Padding="14,6" HorizontalAlignment="Left" Margin="0,10,0,0"
            Command="{Binding PrintCommand}" ToolTip="Preview the results in the list and print them" />
  </Grid>
</UserControl>
